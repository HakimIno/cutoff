import { Palette } from "styles/palette.slint";
import { Theme } from "styles/theme.slint";
import { Header } from "components/header.slint";
import { Sidebar } from "components/sidebar.slint";
import { PreviewPanel } from "components/preview-panel.slint";
import { DetailsPanel } from "components/details-panel.slint";
import { Timeline, RulerTick, TrackData } from "components/timeline.slint";
import { ClipData } from "components/clip-card.slint";

export { RulerTick, TrackData }

export component AppWindow inherits Window {
    title: "cutoff — Pro Video Editor";
    preferred-width: 1320px;
    preferred-height: 820px;
    min-width: 1000px;
    min-height: 640px;
    background: Palette.background;

    // Flat list of all clips — used by Sidebar and as an emptiness check.
    in property <[ClipData]> clips;
    // Dynamic per-track model. Each TrackData carries its own clips list and
    // mute/solo/lock flags. Default project has 4 tracks (V2, V1, A1, A2);
    // users can add more via the +V / +A buttons in the timeline.
    in property <[TrackData]> tracks;
    in property <string> selected-id;
    in property <bool> has-selection;

    // Selected clip details
    in property <string> selected-name;
    in property <string> selected-codec;
    in property <string> selected-resolution;
    in property <string> selected-duration;
    in property <string> selected-fps;
    in property <float> selected-volume;
    in property <bool> selected-muted;
    in property <float> selected-opacity;
    in property <float> selected-scale;
    in property <int> selected-position-x;
    in property <int> selected-position-y;
    in property <float> selected-scale-x: 1.0;
    in property <float> selected-scale-y: 1.0;
    in property <float> selected-rotation: 0.0;
    in property <bool> selected-flip-h: false;
    in property <bool> selected-flip-v: false;
    in property <float> selected-brightness: 0.0;
    in property <float> selected-contrast: 1.0;
    in property <float> selected-saturation: 1.0;
    in property <string> selected-opacity-interp: "linear";
    in property <string> selected-rotation-interp: "linear";
    in property <float> selected-lift-r: 0.0;
    in property <float> selected-lift-g: 0.0;
    in property <float> selected-lift-b: 0.0;
    in property <float> selected-gamma-r: 1.0;
    in property <float> selected-gamma-g: 1.0;
    in property <float> selected-gamma-b: 1.0;
    in property <float> selected-gain-r: 1.0;
    in property <float> selected-gain-g: 1.0;
    in property <float> selected-gain-b: 1.0;
    in property <float> selected-temperature: 0.0;
    in property <float> selected-tint: 0.0;
    in property <float> selected-vignette: 0.0;
    in property <bool> selected-opacity-animated;
    in property <bool> selected-opacity-key;
    in property <bool> selected-scale-animated;
    in property <bool> selected-scale-key;
    in property <bool> selected-position-x-animated;
    in property <bool> selected-position-x-key;
    in property <bool> selected-position-y-animated;
    in property <bool> selected-position-y-key;
    in property <bool> selected-rotation-animated;
    in property <bool> selected-rotation-key;
    in property <int> project-width: 1920;
    in property <int> project-height: 1080;
    in property <int> selected-width: 1920;
    in property <int> selected-height: 1080;

    // Aggregate stats
    in property <int> clip-count;
    in property <string> total-duration;
    in property <string> merge-strategy;
    in property <string> quality-label: "Lossless";

    // Export status
    in property <float> export-progress;
    in property <string> status-text;
    in property <bool> exporting;
    in property <bool> can-export;

    // Preview / playback
    in property <image> preview-frame;
    in property <bool> playing;
    in property <string> playhead-text: "00:00";
    in property <float> playhead-fraction: 0.0;

    // Ruler + zoom
    in property <[RulerTick]> ruler-ticks;
    in property <length> px-per-sec: 6px;
    in property <length> timeline-total-width: 0px;

    // Drag-and-drop reorder state. `drag-from-id` is the source clip id while
    // a drag is in flight (empty when idle); `drop-target-index` / `drop-indicator-x`
    // describe the lane-local insertion point.
    in property <string> drag-from-id;
    in property <int> drop-target-index: -1;
    in property <length> drop-indicator-x: 0px;

    // Toast + FPS readout
    in property <string> toast-message;
    in property <bool> toast-visible;
    in property <float> preview-fps;

    // Callbacks
    callback browse-clicked();
    callback export-clicked();
    callback cancel-clicked();
    callback clip-selected(string);
    callback remove-clicked(string);
    callback play-toggle();
    callback seek-fraction(float);
    callback zoom-in();
    callback zoom-out();
    callback set-zoom(float);   // absolute px-per-sec value
    callback jump-start();
    callback jump-end();
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);
    callback split();
    callback ripple-delete();
    callback step-frame(int);
    callback set-in();
    callback set-out();
    callback undo();
    callback redo();
    callback save-project();
    callback load-project();
    callback dismiss-toast();
    callback reveal-in-finder(string);
    callback toggle-master-mute();
    callback move-to-track(string, int);
    callback detach-audio(string);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback toggle-track-lock(int);
    callback add-video-track();
    callback add-audio-track();
    callback delete-track(int);
    callback selected-clip-volume-changed(float);
    callback selected-clip-muted-changed(bool);
    callback selected-clip-opacity-changed(float);
    callback selected-clip-scale-changed(float);
    callback selected-clip-position-x-changed(int);
    callback selected-clip-position-y-changed(int);
    callback selected-clip-scale-x-changed(float);
    callback selected-clip-scale-y-changed(float);
    callback selected-clip-rotation-changed(float);
    callback selected-clip-flip-h-changed(bool);
    callback selected-clip-flip-v-changed(bool);
    callback selected-clip-brightness-changed(float);
    callback selected-clip-contrast-changed(float);
    callback selected-clip-saturation-changed(float);
    callback selected-clip-color-grading-changed(string, float);
    callback selected-clip-transform-gesture-begin();
    callback selected-clip-keyframe-toggle(int);
    callback selected-clip-keyframe-interp-changed(int, string);

    in property <bool> master-muted;

    forward-focus: key-handler;

    key-handler := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            // Meta (Cmd on macOS) or Control (Win/Linux) shortcuts first
            // so they don't get shadowed by the bare letter handlers below.
            if (event.modifiers.meta || event.modifiers.control) {
                if (event.text == "z" || event.text == "Z") {
                    if (event.modifiers.shift) {
                        root.redo();
                    } else {
                        root.undo();
                    }
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.save-project();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.load-project();
                    return accept;
                }
            }
            if (event.text == " ") {
                root.play-toggle();
                return accept;
            }
            if (event.text == "+" || event.text == "=") {
                root.zoom-in();
                return accept;
            }
            if (event.text == "-" || event.text == "_") {
                root.zoom-out();
                return accept;
            }
            if (event.text == Key.Home) {
                root.jump-start();
                return accept;
            }
            if (event.text == Key.End) {
                root.jump-end();
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                root.split();
                return accept;
            }
            if (event.text == Key.Delete || event.text == Key.Backspace) {
                root.ripple-delete();
                return accept;
            }
            if (event.text == "j" || event.text == "J") {
                root.step-frame(-1);
                return accept;
            }
            if (event.text == "k" || event.text == "K") {
                root.play-toggle();
                return accept;
            }
            if (event.text == "l" || event.text == "L") {
                root.step-frame(1);
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                root.set-in();
                return accept;
            }
            if (event.text == "o" || event.text == "O") {
                root.set-out();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.toggle-master-mute();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            Header {
                can-export: root.can-export;
                exporting: root.exporting;
                export-clicked => { root.export-clicked(); }
                save-project => { root.save-project(); }
                load-project => { root.load-project(); }
                undo => { root.undo(); }
                redo => { root.redo(); }
                zoom-in => { root.zoom-in(); }
                zoom-out => { root.zoom-out(); }
            }

            HorizontalLayout {
                width: 100%;
                spacing: 0px;
                vertical-stretch: 1;

                Sidebar {
                    clips: root.clips;
                    clip-count: root.clip-count;
                    total-duration: root.total-duration;
                    merge-strategy: root.merge-strategy;
                    quality-label: root.quality-label;
                    add-clicked => { root.browse-clicked(); }
                    clip-selected(id) => { root.clip-selected(id); }
                    remove-clicked(id) => { root.remove-clicked(id); }
                }

                // Main center column
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    // Preview area — dominant region (≈60%).
                    Rectangle {
                        vertical-stretch: 3;
                        clip: true;
                        HorizontalLayout {
                            padding: Theme.spacing-lg;
                            PreviewPanel {
                                has-selection: root.clips.length > 0;
                                selected-name: root.has-selection ? root.selected-name : "Project Timeline";
                                selected-resolution: root.has-selection ? root.selected-resolution : "Timeline";
                                selected-duration: root.has-selection ? root.selected-duration : root.total-duration;
                                playhead-text: root.playhead-text;
                                frame: root.preview-frame;
                                playing: root.playing;
                                play-toggle => { root.play-toggle(); }
                                step-frame(delta) => { root.step-frame(delta); }
                                jump-start => { root.jump-start(); }
                                jump-end => { root.jump-end(); }
                                project-width: root.project-width;
                                project-height: root.project-height;
                                selected-width: root.selected-width;
                                selected-height: root.selected-height;
                                selected-scale: root.selected-scale;
                                selected-position-x: root.selected-position-x;
                                selected-position-y: root.selected-position-y;
                                selected-scale-x: root.selected-scale-x;
                                selected-scale-y: root.selected-scale-y;
                                selected-rotation: root.selected-rotation;
                                scale-changed(s) => { root.selected-clip-scale-changed(s); }
                                position-x-changed(x) => { root.selected-clip-position-x-changed(x); }
                                position-y-changed(y) => { root.selected-clip-position-y-changed(y); }
                                scale-x-changed(s) => { root.selected-clip-scale-x-changed(s); }
                                scale-y-changed(s) => { root.selected-clip-scale-y-changed(s); }
                                rotation-changed(r) => { root.selected-clip-rotation-changed(r); }
                                transform-gesture-begin => { root.selected-clip-transform-gesture-begin(); }
                            }
                        }
                    }

                    // Timeline lane — ≈40%, with a sensible minimum.
                    Rectangle {
                        vertical-stretch: 2;
                        min-height: 240px;
                        background: Palette.surface;
                        Rectangle {
                            x: 0; y: 0;
                            width: 100%; height: 1px;
                            background: Palette.border;
                        }
                        Timeline {
                            width: 100%;
                            height: 100%;
                            tracks: root.tracks;
                            all-clips: root.clips;
                            ruler-ticks: root.ruler-ticks;
                            selected-id: root.selected-id;
                            px-per-sec: root.px-per-sec;
                            total-width: root.timeline-total-width;
                            playhead-fraction: root.playhead-fraction;
                            drag-from-id: root.drag-from-id;
                            drop-target-index: root.drop-target-index;
                            drop-indicator-x: root.drop-indicator-x;
                            clip-clicked(id) => { root.clip-selected(id); }
                            remove-clicked(id) => { root.remove-clicked(id); }
                            seek-fraction(f) => { root.seek-fraction(f); }
                            drag-started(id) => { root.drag-started(id); }
                            drag-moved(id, dx) => { root.drag-moved(id, dx); }
                            drag-released(id, dx) => { root.drag-released(id, dx); }
                            trim-released(id, right, dx) => { root.trim-released(id, right, dx); }
                            request-split(id) => {
                                // Split at the current playhead — do NOT reselect
                                // the clip first, or selection would reseek the
                                // playhead to the clip's start and split at 0.
                                root.split();
                            }
                            detach-audio(id) => { root.detach-audio(id); }
                            reveal-in-finder(id) => { root.reveal-in-finder(id); }
                            move-to-track(id, t) => { root.move-to-track(id, t); }
                            toggle-track-mute(t) => { root.toggle-track-mute(t); }
                            toggle-track-solo(t) => { root.toggle-track-solo(t); }
                            toggle-track-lock(t) => { root.toggle-track-lock(t); }
                            add-video-track => { root.add-video-track(); }
                            add-audio-track => { root.add-audio-track(); }
                            delete-track(t) => { root.delete-track(t); }
                            zoom-in => { root.zoom-in(); }
                            zoom-out => { root.zoom-out(); }
                            set-zoom(v) => { root.set-zoom(v); }
                        }
                    }
                }

                DetailsPanel {
                    has-selection: root.has-selection;
                    selected-name: root.selected-name;
                    selected-codec: root.selected-codec;
                    selected-resolution: root.selected-resolution;
                    selected-duration: root.selected-duration;
                    selected-fps: root.selected-fps;
                    selected-volume: root.selected-volume;
                    selected-muted: root.selected-muted;
                    selected-opacity: root.selected-opacity;
                    selected-scale: root.selected-scale;
                    selected-position-x: root.selected-position-x;
                    selected-position-y: root.selected-position-y;
                    selected-scale-x: root.selected-scale-x;
                    selected-scale-y: root.selected-scale-y;
                    selected-rotation: root.selected-rotation;
                    selected-flip-h: root.selected-flip-h;
                    selected-flip-v: root.selected-flip-v;
                    selected-brightness: root.selected-brightness;
                    selected-contrast: root.selected-contrast;
                    selected-saturation: root.selected-saturation;
                    selected-opacity-interp: root.selected-opacity-interp;
                    selected-lift-r: root.selected-lift-r;
                    selected-lift-g: root.selected-lift-g;
                    selected-lift-b: root.selected-lift-b;
                    selected-gamma-r: root.selected-gamma-r;
                    selected-gamma-g: root.selected-gamma-g;
                    selected-gamma-b: root.selected-gamma-b;
                    selected-gain-r: root.selected-gain-r;
                    selected-gain-g: root.selected-gain-g;
                    selected-gain-b: root.selected-gain-b;
                    selected-temperature: root.selected-temperature;
                    selected-tint: root.selected-tint;
                    selected-vignette: root.selected-vignette;
                    selected-rotation-interp: root.selected-rotation-interp;
                    selected-opacity-animated: root.selected-opacity-animated;
                    selected-opacity-key: root.selected-opacity-key;
                    selected-scale-animated: root.selected-scale-animated;
                    selected-scale-key: root.selected-scale-key;
                    selected-position-x-animated: root.selected-position-x-animated;
                    selected-position-x-key: root.selected-position-x-key;
                    selected-position-y-animated: root.selected-position-y-animated;
                    selected-position-y-key: root.selected-position-y-key;
                    selected-rotation-animated: root.selected-rotation-animated;
                    selected-rotation-key: root.selected-rotation-key;
                    keyframe-toggle(ch) => { root.selected-clip-keyframe-toggle(ch); }
                    volume-changed(v) => { root.selected-clip-volume-changed(v); }
                    muted-changed(m) => { root.selected-clip-muted-changed(m); }
                    opacity-changed(o) => { root.selected-clip-opacity-changed(o); }
                    scale-changed(s) => { root.selected-clip-scale-changed(s); }
                    position-x-changed(x) => { root.selected-clip-position-x-changed(x); }
                    position-y-changed(y) => { root.selected-clip-position-y-changed(y); }
                    scale-x-changed(s) => { root.selected-clip-scale-x-changed(s); }
                    scale-y-changed(s) => { root.selected-clip-scale-y-changed(s); }
                    rotation-changed(r) => { root.selected-clip-rotation-changed(r); }
                    flip-h-changed(m) => { root.selected-clip-flip-h-changed(m); }
                    flip-v-changed(m) => { root.selected-clip-flip-v-changed(m); }
                    brightness-changed(b) => { root.selected-clip-brightness-changed(b); }
                    contrast-changed(c) => { root.selected-clip-contrast-changed(c); }
                    saturation-changed(s) => { root.selected-clip-saturation-changed(s); }
                    color-grading-changed(name, val) => { root.selected-clip-color-grading-changed(name, val); }
                    transform-gesture-begin => { root.selected-clip-transform-gesture-begin(); }
                    keyframe-interp-changed(ch, mode) => { root.selected-clip-keyframe-interp-changed(ch, mode); }
                }
            }
        }

        // Toast overlay — bottom-right, click to dismiss.
        if root.toast-visible : Rectangle {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 90px;
            width: 360px;
            height: toast-text.preferred-height + 24px;
            background: Palette.surface-3;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.danger;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;

            HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                alignment: start;

                Rectangle {
                    width: 4px; height: parent.height - 24px;
                    background: Palette.danger;
                    border-radius: 2px;
                }

                toast-text := Text {
                    text: root.toast-message;
                    color: Palette.text;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.dismiss-toast(); }
            }
        }
    }
}
