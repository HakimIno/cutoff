import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { ClipData } from "clip-card.slint";
import { ScrollView } from "std-widgets.slint";

component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.text;
    height: 28px;

    HorizontalLayout {
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-lg;
        alignment: space-between;
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: Theme.font-xs;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: Theme.font-xs;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: Palette.border;
        opacity: 0.4;
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
    opacity: 0.8;
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Palette.accent-2 : Palette.accent;
    animate background { duration: 120ms; }

    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: white;
        font-size: Theme.font-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component MediaLibraryCard inherits Rectangle {
    in property <ClipData> data;
    callback clicked();
    callback remove();

    height: 52px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Palette.surface-2 : Palette.surface;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.border-bright : Palette.border;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    ta := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding: 3px;
        spacing: Theme.spacing-md;

        // Thumbnail
        Rectangle {
            width: 64px;
            height: 44px;
            background: black;
            border-radius: Theme.radius-sm;
            clip: true;

            for thumb[i] in root.data.thumbnails: Image {
                source: thumb;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            // Duration badge overlay at bottom right
            Rectangle {
                x: parent.width - self.width - 2px;
                y: parent.height - self.height - 2px;
                width: self.preferred-width + 4px;
                height: 12px;
                background: #000000aa;
                border-radius: 2px;
                Text {
                    text: root.data.duration;
                    color: white;
                    font-size: 8px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Title + Quick Metadata
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.data.name;
                color: Palette.text;
                font-size: Theme.font-xs;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.data.resolution;
                color: Palette.text-dim;
                font-size: 9px;
            }
        }

        // Delete button
        if ta.has-hover : Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: del-ta.has-hover ? Palette.danger : transparent;
            Text {
                text: "×";
                color: Palette.text;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            del-ta := TouchArea {
                clicked => { root.remove(); }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ClipData]> clips;
    in property <int> clip-count;
    in property <string> total-duration;
    in property <string> merge-strategy;
    in property <string> quality-label: "Lossless";

    callback add-clicked();
    callback clip-selected(string);
    callback remove-clicked(string);

    width: 240px;
    background: Palette.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px; height: 100%;
        background: Palette.border;
    }

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // Primary action
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding: Theme.spacing-lg;
                PrimaryButton {
                    label: "+  Add Clips";
                    clicked => { root.add-clicked(); }
                }
            }
        }

        Divider {}

        // Library Title
        Rectangle {
            height: 28px;
            HorizontalLayout {
                padding-left: Theme.spacing-lg;
                padding-right: Theme.spacing-lg;
                alignment: space-between;
                Text {
                    text: "MEDIA LIBRARY";
                    color: Palette.text-muted;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.clips.length + " clips";
                    color: Palette.text-dim;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }
        }

        // Scrollable loaded clips
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-bottom: Theme.spacing-md;

                ScrollView {
                    viewport-height: root.clips.length * 56px;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        for clip[idx] in root.clips: MediaLibraryCard {
                            data: clip;
                            clicked => { root.clip-selected(clip.id); }
                            remove => { root.remove-clicked(clip.id); }
                        }
                    }
                }
            }
        }

        Divider {}

        Rectangle {
            background: Palette.surface-2;
            VerticalLayout {
                spacing: 0px;
                alignment: end;

                StatRow {
                    label: "TOTAL DURATION";
                    value: root.total-duration == "" ? "00:00" : root.total-duration;
                }
                StatRow {
                    label: "STRATEGY";
                    value: root.merge-strategy == "" ? "—" : root.merge-strategy;
                }
                StatRow {
                    label: "EXPORT QUALITY";
                    value: root.quality-label;
                }
            }
        }
    }
}
