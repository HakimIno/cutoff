import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { ClipData } from "clip-card.slint";
import { ScrollView } from "std-widgets.slint";
import { MediaLibraryCard } from "media-library-card.slint";
import { TabButton, SubTabButton, TextPresetCard, ShapePresetCard, TransitionPresetCard } from "sidebar-components.slint";

component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.text;
    height: 28px;

    HorizontalLayout {
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-lg;
        alignment: space-between;
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: Theme.font-xs;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: Palette.border;
        opacity: 0.4;
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
    opacity: 0.8;
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.border-bright : Palette.border;
    background: ta.has-hover ? Palette.surface-2 : Palette.surface;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Palette.text;
        font-size: Theme.font-sm;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Sidebar inherits Rectangle {
    in property <[ClipData]> clips;
    in property <int> clip-count;
    in property <string> total-duration;
    in property <string> merge-strategy;
    in property <string> quality-label: "Lossless";

    callback add-clicked();
    callback clip-selected(string);
    callback remove-clicked(string);

    width: 300px;
    background: Palette.surface;

    property <int> active-tab: 0;
    property <int> active-subtab: 0;

    Rectangle {
        x: parent.width - 1px;
        width: 1px; height: 100%;
        background: Palette.border;
    }

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // Top Navigation Tabs
        Rectangle {
            height: 64px;
            background: Palette.surface;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TabButton {
                    text: "Assets"; has-icon: true; icon: @image-url("../../../../assets/solar/folder.svg");
                    active: root.active-tab == 0; clicked => { root.active-tab = 0; }
                }
                TabButton {
                    text: "Text"; has-icon: true; icon: @image-url("../../../../assets/solar/text.svg");
                    active: root.active-tab == 1; clicked => { root.active-tab = 1; }
                }
                TabButton {
                    text: "Shapes"; has-icon: true; icon: @image-url("../../../../assets/solar/shapes.svg");
                    active: root.active-tab == 2; clicked => { root.active-tab = 2; }
                }
                TabButton {
                    text: "Transitions"; has-icon: true; icon: @image-url("../../../../assets/solar/transitions.svg");
                    active: root.active-tab == 3; clicked => { root.active-tab = 3; }
                }
            }
        }
        
        Divider {}

        // TAB 0: Assets View
        if root.active-tab == 0 : VerticalLayout {
            // Filter Sub Tabs
            Rectangle {
                height: 48px;
                background: Palette.surface-2;
                
                Rectangle {
                    x: 12px; y: 8px;
                    width: parent.width - 24px;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: Palette.surface-3;
                    
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        SubTabButton { text: "All (" + root.clips.length + ")"; active: root.active-subtab == 0; clicked => { root.active-subtab = 0; } }
                        SubTabButton { text: "Video (" + root.clips.length + ")"; active: root.active-subtab == 1; clicked => { root.active-subtab = 1; } }
                        SubTabButton { text: "Audio (0)"; active: root.active-subtab == 2; clicked => { root.active-subtab = 2; } }
                        SubTabButton { text: "Image (0)"; active: root.active-subtab == 3; clicked => { root.active-subtab = 3; } }
                    }
                }
            }

            // Import Button
            Rectangle {
                height: 60px;
                background: Palette.surface-2;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-bottom: 12px; padding-top: 4px;
                    PrimaryButton {
                        label: "+  Import";
                        clicked => { root.add-clicked(); }
                    }
                }
            }

            // Scrollable loaded clips
            Rectangle {
                vertical-stretch: 1;
                background: Palette.surface-2;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 12px;

                    ScrollView {
                        viewport-height: root.clips.length * 168px;
                        VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            for clip[idx] in root.clips: MediaLibraryCard {
                                data: clip;
                                clicked => { root.clip-selected(clip.id); }
                                remove => { root.remove-clicked(clip.id); }
                            }
                        }
                    }
                }
            }
        }

        // TAB 1: Text
        if root.active-tab == 1 : Rectangle {
            vertical-stretch: 1;
            background: Palette.surface-2;
            
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                
                Text {
                    text: "Add Text";
                    color: Palette.text;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                }
                
                TextPresetCard { label: "Heading"; preview-text: "Heading"; font-size: 24px; font-weight: 800; }
                TextPresetCard { label: "Subtitle"; preview-text: "Subtitle"; font-size: 18px; font-weight: 600; }
                TextPresetCard { label: "Body text"; preview-text: "Body text"; font-size: 14px; font-weight: 400; }
            }
        }

        // TAB 2: Shapes
        if root.active-tab == 2 : Rectangle {
            vertical-stretch: 1;
            background: Palette.surface-2;
            
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                
                Text {
                    text: "Basic Shapes";
                    color: Palette.text;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                }
                
                HorizontalLayout {
                    spacing: 12px;
                    ShapePresetCard { label: "Rectangle"; is-circle: false; }
                    ShapePresetCard { label: "Circle"; is-circle: true; }
                }
            }
        }

        // TAB 3: Transitions
        if root.active-tab == 3 : Rectangle {
            vertical-stretch: 1;
            background: Palette.surface-2;
            
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                
                Text {
                    text: "Video Transitions";
                    color: Palette.text;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                }
                
                TransitionPresetCard { label: "Cross Dissolve"; }
                TransitionPresetCard { label: "Dip to Black"; }
                TransitionPresetCard { label: "Dip to White"; }
                TransitionPresetCard { label: "Wipe Left"; }
            }
        }

        Divider {}

        Rectangle {
            background: Palette.surface-2;
            VerticalLayout {
                spacing: 0px;
                alignment: end;

                StatRow {
                    label: "Total duration";
                    value: root.total-duration == "" ? "00:00" : root.total-duration;
                }
                StatRow {
                    label: "Strategy";
                    value: root.merge-strategy == "" ? "—" : root.merge-strategy;
                }
                StatRow {
                    label: "Export quality";
                    value: root.quality-label;
                }
            }
        }
    }
}
