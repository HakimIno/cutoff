import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";

component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.text;
    height: 28px;

    HorizontalLayout {
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-lg;
        alignment: space-between;
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: Theme.font-xs;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: Palette.border;
        opacity: 0.4;
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
    opacity: 0.8;
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Palette.accent-2 : Palette.accent;
    animate background { duration: 120ms; }

    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: white;
        font-size: Theme.font-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Sidebar inherits Rectangle {
    in property <int> clip-count;
    in property <string> total-duration;
    in property <string> merge-strategy;
    in property <string> quality-label: "Lossless";

    callback add-clicked();

    width: 240px;
    background: Palette.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px; height: 100%;
        background: Palette.border;
    }

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // Primary action
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding: Theme.spacing-lg;
                PrimaryButton {
                    label: "+  Add Clips";
                    clicked => { root.add-clicked(); }
                }
            }
        }

        Divider {}

        // Stats
        StatRow {
            label: "CLIPS";
            value: root.clip-count;
        }
        StatRow {
            label: "DURATION";
            value: root.total-duration == "" ? "00:00" : root.total-duration;
        }

        Divider {}

        // Strategy
        VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-xs;
            Text {
                text: "STRATEGY";
                color: Palette.text-muted;
                font-size: Theme.font-xs;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: start;
                Rectangle {
                    width: 8px; height: 8px;
                    border-radius: 4px;
                    y: (parent.height - self.height) / 2;
                    background: root.merge-strategy == "Stream-copy"
                        ? Palette.success
                        : (root.merge-strategy == "" ? Palette.text-dim : Palette.warning);
                }
                Text {
                    text: root.merge-strategy == "" ? "—" : root.merge-strategy;
                    color: Palette.text;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        Divider {}

        // Quality
        VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-xs;
            Text {
                text: "QUALITY";
                color: Palette.text-muted;
                font-size: Theme.font-xs;
                letter-spacing: 1px;
            }
            Text {
                text: root.quality-label;
                color: Palette.text;
                font-size: Theme.font-md;
                font-weight: 600;
            }
        }
    }
}
