import { Palette } from "../styles/palette.slint";

export component PlayIcon inherits Path {
    in property <color> icon-color: Palette.text;
    fill: root.icon-color;
    width: 12px;
    height: 12px;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: "M 4 2 L 13 8 L 4 14 Z";
}

export component PauseIcon inherits Path {
    in property <color> icon-color: Palette.text;
    fill: root.icon-color;
    width: 12px;
    height: 12px;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: "M 3 2 H 6 V 14 H 3 Z M 10 2 H 13 V 14 H 10 Z";
}

