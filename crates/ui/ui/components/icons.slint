import { Palette } from "../styles/palette.slint";

// Solar bold icons (PNG, white glyph — tint with `colorize`).
// Assets: assets/solar/ (from Iconify solar collection).

component SolarIcon inherits Image {
    in property <color> icon-color: Palette.text;
    in property <image> glyph;
    source: root.glyph;
    width: 14px;
    height: 14px;
    image-fit: contain;
    colorize: root.icon-color;
}

export component PlayIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--play-bold.png");
}

export component PauseIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--pause-bold.png");
}

export component SkipStartIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--skip-previous-bold.png");
}

export component SkipEndIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--skip-next-bold.png");
}

export component StepBackwardIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--rewind-back-bold.png");
}

export component StepForwardIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--forward-bold.png");
}

export component CloseIcon inherits SolarIcon {
    width: 12px;
    height: 12px;
    glyph: @image-url("../../../../assets/solar/solar--close-circle-bold.png");
}

export component SpeakerIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--volume-bold.png");
}

export component SpeakerMutedIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--volume-cross-bold.png");
}

export component EyeLineIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--eye-bold.png");
}

export component EyeOffLineIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--eye-closed-bold.png");
}

export component LockClosedIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--lock-bold.png");
}

export component LockOpenIcon inherits SolarIcon {
    glyph: @image-url("../../../../assets/solar/solar--lock-unlocked-bold.png");
}
