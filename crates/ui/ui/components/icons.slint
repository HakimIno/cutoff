import { Palette } from "../styles/palette.slint";

// Majesticons line icons (PNG, white glyph — tint with `colorize`).
// Assets: assets/majesticons/ (from Iconify majesticons collection).

component MajesticonsIcon inherits Image {
    in property <color> icon-color: Palette.text;
    in property <image> glyph;
    source: root.glyph;
    width: 14px;
    height: 14px;
    image-fit: contain;
    colorize: root.icon-color;
}

export component PlayIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--play-circle-line.png");
}

export component PauseIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--pause-line.png");
}

export component SkipStartIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--backward-start-circle-line.png");
}

export component SkipEndIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--forward-end-circle-line.png");
}

export component StepBackwardIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--rewind-line.png");
}

export component StepForwardIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--fast-forward-line.png");
}

export component CloseIcon inherits MajesticonsIcon {
    width: 12px;
    height: 12px;
    glyph: @image-url("../../../../assets/majesticons/majesticons--close-line.png");
}

export component SpeakerIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--speaker-line.png");
}

export component SpeakerMutedIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--sound-off-line.png");
}

export component EyeLineIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--eye-line.png");
}

export component EyeOffLineIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--eye-off-line.png");
}

export component LockClosedIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--lock-line.png");
}

export component LockOpenIcon inherits MajesticonsIcon {
    glyph: @image-url("../../../../assets/majesticons/majesticons--unlock-open-line.png");
}
