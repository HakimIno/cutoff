/// Majesticons eye-line (white glyph; tinted via `colorize`).
export component EyeLineIcon inherits Image {
    in property <color> icon-color: Palette.text;
    source: @image-url("../../../../assets/majesticons/majesticons--eye-line.png");
    width: 14px;
    height: 14px;
    image-fit: contain;
    colorize: root.icon-color;
}

/// Majesticons eye-off-line — hidden / muted video track.
export component EyeOffLineIcon inherits Image {
    in property <color> icon-color: Palette.text;
    source: @image-url("../../../../assets/majesticons/majesticons--eye-off-line.png");
    width: 14px;
    height: 14px;
    image-fit: contain;
    colorize: root.icon-color;
}

