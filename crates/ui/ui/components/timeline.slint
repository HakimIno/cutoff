import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { ClipBlock, ClipData } from "clip-card.slint";
import { DropIndicator } from "drop-indicator.slint";
import { TrackHeader } from "track-header.slint";
import { ScrollView } from "std-widgets.slint";

export struct RulerTick {
    x: length,
    label: string,
    major: bool,
}

/// Single lane that renders clips belonging to one video track.
component TrackLane inherits Rectangle {
    in property <[ClipData]> clips;
    in property <string> selected-id;
    in property <length> px-per-sec: 6px;
    in property <string> drag-from-id;

    callback clip-clicked(string);
    callback remove-clicked(string);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);
    callback request-split(string);
    callback reveal-in-finder(string);
    callback move-to-track(string, int);

    HorizontalLayout {
        padding-left: Theme.spacing-xs;
        padding-right: Theme.spacing-xs;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 1px;
        alignment: start;
        for clip[idx] in root.clips: ClipBlock {
            data: clip;
            index: idx;
            px-per-sec: root.px-per-sec;
            selected: clip.id == root.selected-id;
            drag-ghost: root.drag-from-id != "" && clip.id == root.drag-from-id;
            clip-clicked(id)      => { root.clip-clicked(id); }
            remove-clicked(id)    => { root.remove-clicked(id); }
            drag-started(id)      => { root.drag-started(id); }
            drag-moved(id, dx)    => { root.drag-moved(id, dx); }
            drag-released(id, dx) => { root.drag-released(id, dx); }
            trim-released(id, right, dx) => { root.trim-released(id, right, dx); }
            request-split(id)     => { root.request-split(id); }
            reveal-in-finder(id)  => { root.reveal-in-finder(id); }
            move-to-track(id, t)  => { root.move-to-track(id, t); }
        }
    }
}

export component Timeline inherits Rectangle {
    in property <[ClipData]> clips-v1;
    in property <[ClipData]> clips-v2;
    in property <[ClipData]> clips-a1;
    in property <[ClipData]> clips-a2;
    in property <[RulerTick]> ruler-ticks;
    in property <string> selected-id;
    in property <length> px-per-sec: 6px;
    in property <length> total-width: 0px;
    in property <float> playhead-fraction: 0.0;

    in property <string> drag-from-id;
    in property <int> drop-target-index: -1;
    in property <length> drop-indicator-x: 0px;

    in property <bool> v1-muted;
    in property <bool> v2-muted;
    in property <bool> a1-muted;
    in property <bool> a2-muted;

    in property <bool> v1-soloed;
    in property <bool> v2-soloed;
    in property <bool> a1-soloed;
    in property <bool> a2-soloed;

    in property <bool> v1-locked;
    in property <bool> v2-locked;
    in property <bool> a1-locked;
    in property <bool> a2-locked;

    callback clip-clicked(string);
    callback remove-clicked(string);
    callback seek-fraction(float);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);
    callback request-split(string);
    callback reveal-in-finder(string);
    callback move-to-track(string, int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback toggle-track-lock(int);

    background: Palette.background;

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;
        alignment: start;

        HorizontalLayout {
            spacing: Theme.spacing-md;
            alignment: space-between;
            Text {
                text: "TIMELINE";
                color: Palette.text-muted;
                font-size: Theme.font-xs;
                letter-spacing: 1.5px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: (root.clips-v1.length + root.clips-v2.length + root.clips-a1.length + root.clips-a2.length) == 0
                    ? "Empty"
                    : (root.clips-v1.length + root.clips-v2.length + root.clips-a1.length + root.clips-a2.length) + " clips · 4 tracks · drag-drop video files · right-click to switch tracks";
                color: Palette.text-dim;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }

        // Lane container — fixed-width left rail with TrackHeaders, scrollable right region for ruler + lanes.
        Rectangle {
            height: 364px;
            border-radius: Theme.radius;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;

            HorizontalLayout {
                spacing: 0px;

                // Left rail: track headers
                Rectangle {
                    width: 60px;
                    background: Palette.surface;
                    VerticalLayout {
                        padding-top: 26px; // align with ruler height (24px ruler + 2px offset)
                        padding-left: 2px;
                        padding-right: 2px;
                        spacing: 4px;
                        TrackHeader {
                            label: "V2";
                            badge-color: Palette.accent-2;
                            muted: root.v2-muted;
                            soloed: root.v2-soloed;
                            locked: root.v2-locked;
                            height: 80px;
                            toggle-mute => { root.toggle-track-mute(1); }
                            toggle-solo => { root.toggle-track-solo(1); }
                            toggle-lock => { root.toggle-track-lock(1); }
                        }
                        TrackHeader {
                            label: "V1";
                            badge-color: Palette.accent;
                            muted: root.v1-muted;
                            soloed: root.v1-soloed;
                            locked: root.v1-locked;
                            height: 80px;
                            toggle-mute => { root.toggle-track-mute(0); }
                            toggle-solo => { root.toggle-track-solo(0); }
                            toggle-lock => { root.toggle-track-lock(0); }
                        }
                        TrackHeader {
                            label: "A1";
                            badge-color: Palette.success;
                            muted: root.a1-muted;
                            soloed: root.a1-soloed;
                            locked: root.a1-locked;
                            height: 80px;
                            toggle-mute => { root.toggle-track-mute(2); }
                            toggle-solo => { root.toggle-track-solo(2); }
                            toggle-lock => { root.toggle-track-lock(2); }
                        }
                        TrackHeader {
                            label: "A2";
                            badge-color: Palette.success;
                            muted: root.a2-muted;
                            soloed: root.a2-soloed;
                            locked: root.a2-locked;
                            height: 80px;
                            toggle-mute => { root.toggle-track-mute(3); }
                            toggle-solo => { root.toggle-track-solo(3); }
                            toggle-lock => { root.toggle-track-lock(3); }
                        }
                    }
                }

                // Right side: ruler + lanes
                Rectangle {
                    horizontal-stretch: 1;

                    if (root.clips-v1.length + root.clips-v2.length + root.clips-a1.length + root.clips-a2.length) == 0 : VerticalLayout {
                        alignment: center;
                        spacing: Theme.spacing-xs;
                        Text {
                            text: "No clips yet";
                            color: Palette.text-muted;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Click  +  Add Clips  or drop a video onto the window";
                            color: Palette.text-dim;
                            font-size: Theme.font-xs;
                            horizontal-alignment: center;
                        }
                    }

                    if (root.clips-v1.length + root.clips-v2.length + root.clips-a1.length + root.clips-a2.length) > 0 : ScrollView {
                        viewport-height: self.visible-height;
                        viewport-width: max(root.total-width + 12px, self.visible-width);

                        Rectangle {
                            width: max(root.total-width + 12px, parent.width);
                            height: 362px;

                            // Ruler strip
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: 24px;
                                background: Palette.surface-2;

                                Rectangle {
                                    x: 0;
                                    y: parent.height - 1px;
                                    width: parent.width;
                                    height: 1px;
                                    background: Palette.border;
                                }

                                for tick in root.ruler-ticks: Rectangle {
                                    x: tick.x;
                                    y: tick.major ? 12px : 17px;
                                    width: 1px;
                                    height: tick.major ? 12px : 7px;
                                    background: tick.major ? Palette.text-muted : Palette.text-dim;
                                }

                                for tick in root.ruler-ticks: Text {
                                    visible: tick.major;
                                    x: tick.x + 3px;
                                    y: 2px;
                                    text: tick.label;
                                    color: Palette.text-muted;
                                    font-size: Theme.font-xs;
                                    font-weight: 500;
                                }

                                ruler-scrub := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (self.width > 0px) {
                                            root.seek-fraction(self.pressed-x / self.width);
                                        }
                                    }
                                }
                            }

                            // V2 lane (top, 80px)
                            v2-lane := TrackLane {
                                x: 0;
                                y: 26px;
                                width: parent.width;
                                height: 80px;
                                background: root.v2-muted
                                    ? Palette.danger-soft
                                    : (root.clips-v2.length == 0 ? Palette.background : transparent);
                                clips: root.clips-v2;
                                selected-id: root.selected-id;
                                px-per-sec: root.px-per-sec;
                                drag-from-id: root.drag-from-id;
                                clip-clicked(id)      => { root.clip-clicked(id); }
                                remove-clicked(id)    => { root.remove-clicked(id); }
                                drag-started(id)      => { root.drag-started(id); }
                                drag-moved(id, dx)    => { root.drag-moved(id, dx); }
                                drag-released(id, dx) => { root.drag-released(id, dx); }
                                trim-released(id, r, dx) => { root.trim-released(id, r, dx); }
                                request-split(id)     => { root.request-split(id); }
                                reveal-in-finder(id)  => { root.reveal-in-finder(id); }
                                move-to-track(id, t)  => { root.move-to-track(id, t); }
                            }

                            // V1 lane (80px)
                            v1-lane := TrackLane {
                                x: 0;
                                y: 110px;
                                width: parent.width;
                                height: 80px;
                                background: root.v1-muted
                                    ? Palette.danger-soft
                                    : (root.clips-v1.length == 0 ? Palette.background : transparent);
                                clips: root.clips-v1;
                                selected-id: root.selected-id;
                                px-per-sec: root.px-per-sec;
                                drag-from-id: root.drag-from-id;
                                clip-clicked(id)      => { root.clip-clicked(id); }
                                remove-clicked(id)    => { root.remove-clicked(id); }
                                drag-started(id)      => { root.drag-started(id); }
                                drag-moved(id, dx)    => { root.drag-moved(id, dx); }
                                drag-released(id, dx) => { root.drag-released(id, dx); }
                                trim-released(id, r, dx) => { root.trim-released(id, r, dx); }
                                request-split(id)     => { root.request-split(id); }
                                reveal-in-finder(id)  => { root.reveal-in-finder(id); }
                                move-to-track(id, t)  => { root.move-to-track(id, t); }
                            }

                            // A1 lane (80px)
                            a1-lane := TrackLane {
                                x: 0;
                                y: 194px;
                                width: parent.width;
                                height: 80px;
                                background: root.a1-muted
                                    ? Palette.danger-soft
                                    : (root.clips-a1.length == 0 ? Palette.background : transparent);
                                clips: root.clips-a1;
                                selected-id: root.selected-id;
                                px-per-sec: root.px-per-sec;
                                drag-from-id: root.drag-from-id;
                                clip-clicked(id)      => { root.clip-clicked(id); }
                                remove-clicked(id)    => { root.remove-clicked(id); }
                                drag-started(id)      => { root.drag-started(id); }
                                drag-moved(id, dx)    => { root.drag-moved(id, dx); }
                                drag-released(id, dx) => { root.drag-released(id, dx); }
                                trim-released(id, r, dx) => { root.trim-released(id, r, dx); }
                                request-split(id)     => { root.request-split(id); }
                                reveal-in-finder(id)  => { root.reveal-in-finder(id); }
                                move-to-track(id, t)  => { root.move-to-track(id, t); }
                            }

                            // A2 lane (80px)
                            a2-lane := TrackLane {
                                x: 0;
                                y: 278px;
                                width: parent.width;
                                height: 80px;
                                background: root.a2-muted
                                    ? Palette.danger-soft
                                    : (root.clips-a2.length == 0 ? Palette.background : transparent);
                                clips: root.clips-a2;
                                selected-id: root.selected-id;
                                px-per-sec: root.px-per-sec;
                                drag-from-id: root.drag-from-id;
                                clip-clicked(id)      => { root.clip-clicked(id); }
                                remove-clicked(id)    => { root.remove-clicked(id); }
                                drag-started(id)      => { root.drag-started(id); }
                                drag-moved(id, dx)    => { root.drag-moved(id, dx); }
                                drag-released(id, dx) => { root.drag-released(id, dx); }
                                trim-released(id, r, dx) => { root.trim-released(id, r, dx); }
                                request-split(id)     => { root.request-split(id); }
                                reveal-in-finder(id)  => { root.reveal-in-finder(id); }
                                move-to-track(id, t)  => { root.move-to-track(id, t); }
                            }

                            // Drop indicator (drawn over active lanes)
                            if root.drop-target-index >= 0 : DropIndicator {
                                x: root.drop-indicator-x;
                                y: 26px;
                                height: 332px;
                            }

                            // Playhead spans both lanes
                            Rectangle {
                                visible: root.selected-id != "" && root.total-width > 0px;
                                x: root.playhead-fraction * parent.width;
                                y: 0;
                                width: 1px;
                                height: parent.height;
                                background: Palette.accent-2;
                            }
                            Rectangle {
                                visible: root.selected-id != "" && root.total-width > 0px;
                                x: root.playhead-fraction * parent.width - 3px;
                                y: 0;
                                width: 7px;
                                height: 5px;
                                background: Palette.accent-2;
                                border-radius: 1px;
                            }
                        }
                    }
                }
            }
        }
    }
}
