import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { ClipBlock, ClipData } from "clip-card.slint";
import { DropIndicator } from "drop-indicator.slint";
import { TrackHeader } from "track-header.slint";
import { ScrollView } from "std-widgets.slint";

export struct RulerTick {
    x: length,
    label: string,
    major: bool,
}

/// Per-track data passed from Rust. `clips` is a Slint model of ClipData;
/// `video-track-value` is the u8 value that `clip.video-track` should equal
/// for a clip that lives on this track (legacy semantic for V1/V2/A1/A2,
/// project-index for user-added tracks).
export struct TrackData {
    name: string,
    is-audio: bool,
    clips: [ClipData],
    display-only: bool,
    muted: bool,
    soloed: bool,
    locked: bool,
    video-track-value: int,
}

/// Single lane that renders clips belonging to one track.
component TrackLane inherits Rectangle {
    in property <[ClipData]> clips;
    in property <string> selected-id;
    in property <length> px-per-sec: 6px;
    in property <string> drag-from-id;
    in property <int> drop-target-index: -1;
    in property <length> drop-indicator-x: 0px;
    in property <bool> is-audio: false;
    in property <bool> muted: false;
    in property <bool> interactive: true;
    in property <color> accent-color: Palette.accent;

    callback clip-clicked(string);
    callback remove-clicked(string);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);
    callback request-split(string);
    callback reveal-in-finder(string);
    callback move-to-track(string, int);

    background: root.muted
        ? Palette.danger-soft
        : (root.is-audio ? #0d1714 : #101217);
    border-radius: 2px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 1px;
        background: root.accent-color.with-alpha(0.18);
    }

    // Clips are positioned by their absolute timeline start so the lane can
    // hold gaps and freely-dragged cards. `start-secs` is filled per-track by
    // `sync_tracks`; multiplying by `px-per-sec` aligns each card with the
    // ruler ticks and gridlines (which share the same origin).
    for clip[idx] in root.clips: ClipBlock {
        // While this card is the one being dragged, follow the snapped target
        // position (computed in Rust) so it glides between valid spots like a
        // magnetic drag overlay. Otherwise sit at the clip's real start.
        x: (root.drag-from-id == clip.id && root.drop-target-index >= 0)
            ? root.drop-indicator-x
            : clip.start-secs * root.px-per-sec;
        y: 4px;
        // Only the dragged card glides; others snap instantly so they don't
        // lag the ruler while zooming.
        animate x { duration: root.drag-from-id == clip.id ? 70ms : 0ms; easing: ease-out; }
        data: clip;
        index: idx;
        px-per-sec: root.px-per-sec;
        selected: clip.id == root.selected-id;
        drag-ghost: root.drag-from-id != "" && clip.id == root.drag-from-id;
        is-audio: root.is-audio;
        interactive: root.interactive;
        accent-color: root.accent-color;
        clip-clicked(id)      => { root.clip-clicked(id); }
        remove-clicked(id)    => { root.remove-clicked(id); }
        drag-started(id)      => { root.drag-started(id); }
        drag-moved(id, dx)    => { root.drag-moved(id, dx); }
        drag-released(id, dx) => { root.drag-released(id, dx); }
        trim-released(id, right, dx) => { root.trim-released(id, right, dx); }
        request-split(id)     => { root.request-split(id); }
        reveal-in-finder(id)  => { root.reveal-in-finder(id); }
        move-to-track(id, t)  => { root.move-to-track(id, t); }
    }
}

// Small square +/− button for the zoom cluster.
component ZoomButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.border-bright : Palette.border;
    background: ta.has-hover ? Palette.surface-2 : transparent;
    animate background { duration: 100ms; }
    Text {
        text: root.glyph;
        color: Palette.text-muted;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Timeline inherits Rectangle {
    in property <[TrackData]> tracks;
    in property <[ClipData]> all-clips;     // used only for empty-state check
    in property <[RulerTick]> ruler-ticks;
    in property <string> selected-id;
    in property <length> px-per-sec: 6px;
    in property <length> total-width: 0px;
    in property <float> playhead-fraction: 0.0;

    in property <string> drag-from-id;
    in property <int> drop-target-index: -1;
    in property <length> drop-indicator-x: 0px;

    callback clip-clicked(string);
    callback remove-clicked(string);
    callback seek-fraction(float);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);
    callback request-split(string);
    callback reveal-in-finder(string);
    callback move-to-track(string, int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback toggle-track-lock(int);
    callback add-video-track();
    callback add-audio-track();
    callback delete-track(int);
    callback zoom-in();
    callback zoom-out();
    callback set-zoom(float);   // absolute px-per-sec value

    background: Palette.background;

    // Current zoom expressed as a 0..1 slider fraction (linear over the
    // 1..200 px-per-sec range the Rust side clamps to).
    property <float> zoom-fraction:
        max(0.0, min(1.0, (root.px-per-sec / 1px - 1.0) / 199.0));

    // Per-lane visual height.
    property <length> lane-height: 64px;
    property <length> lane-gap: 4px;
    property <length> ruler-height: 28px;
    property <length> ruler-offset: 4px;
    property <length> header-rail-width: 184px;
    property <length> add-row-height: 30px;

    // Height of the stacked track lanes + the add-track row (excludes the
    // ruler, which is now a separate sticky strip). This is the vertical
    // scroll content height shared by the left rail and the lane area.
    property <length> stack-height:
        root.ruler-offset
        + root.tracks.length * (root.lane-height + root.lane-gap)
        + root.add-row-height;

    // Shared scroll offsets so the sticky ruler, left header rail, and the
    // lane area stay in sync: ruler ↔ lanes on X, header rail ↔ lanes on Y.
    property <length> h-scroll;
    property <length> v-scroll;

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        HorizontalLayout {
            spacing: Theme.spacing-sm;
            vertical-stretch: 0;
            Text {
                text: "Timeline";
                color: Palette.text;
                font-size: Theme.font-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.all-clips.length == 0
                    ? "Empty"
                    : root.all-clips.length + (root.all-clips.length == 1 ? " clip · " : " clips · ") + root.tracks.length + " tracks";
                color: Palette.text-dim;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }

            // Spacer pushes the zoom cluster to the right edge.
            Rectangle { horizontal-stretch: 1; }

            // ── Zoom cluster ──
            ZoomButton {
                glyph: "−";
                clicked => { root.zoom-out(); }
            }
            // Slider track
            Rectangle {
                width: 104px;
                height: 22px;
                zoom-track := Rectangle {
                    width: 100%;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Palette.surface-3;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.zoom-fraction;
                        height: 100%;
                        border-radius: 2px;
                        background: Palette.accent;
                    }
                    Rectangle {
                        width: 11px;
                        height: 11px;
                        border-radius: 6px;
                        x: (parent.width - self.width) * root.zoom-fraction;
                        y: (parent.height - self.height) / 2;
                        background: zoom-ta.has-hover || zoom-ta.pressed ? white : Palette.text;
                        border-width: 1px;
                        border-color: Palette.border-bright;
                    }
                }
                zoom-ta := TouchArea {
                    mouse-cursor: pointer;
                    width: 100%;
                    height: 100%;
                    moved => {
                        if (self.pressed && self.width > 0px) {
                            let f = max(0.0, min(1.0, self.mouse-x / self.width));
                            root.set-zoom(1.0 + f * 199.0);
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && self.width > 0px) {
                            let f = max(0.0, min(1.0, self.mouse-x / self.width));
                            root.set-zoom(1.0 + f * 199.0);
                        }
                    }
                }
            }
            ZoomButton {
                glyph: "+";
                clicked => { root.zoom-in(); }
            }
        }

        Rectangle {
            // Fill the available timeline area; lanes scroll vertically when tracks overflow.
            vertical-stretch: 1;
            border-radius: Theme.radius-sm;
            background: #101115;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;

            HorizontalLayout {
                spacing: 0px;

                // ── Left rail: corner + vertically-scrolling track headers ──
                Rectangle {
                    width: root.header-rail-width;
                    background: #121318;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Palette.border;
                    }

                    VerticalLayout {
                        spacing: 0px;

                        // Corner box, aligned with the ruler strip on the right.
                        Rectangle {
                            height: root.ruler-height;
                            background: #15171d;
                            Rectangle {
                                x: 0; y: parent.height - 1px;
                                width: 100%; height: 1px;
                                background: Palette.border;
                            }
                        }

                        head-sv := ScrollView {
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            viewport-y <=> root.v-scroll;
                            viewport-height: root.stack-height;

                            VerticalLayout {
                                padding-top: root.ruler-offset;
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: root.lane-gap;
                                for track[idx] in root.tracks : TrackHeader {
                                    label: track.name;
                                    clip-count: track.clips.length;
                                    is-audio: track.is-audio;
                                    badge-color: track.is-audio ? Palette.success : Palette.accent;
                                    muted: track.muted;
                                    soloed: track.soloed;
                                    locked: track.locked;
                                    // Don't let users delete the very last track.
                                    deletable: root.tracks.length > 1;
                                    height: root.lane-height;
                                    toggle-mute => { root.toggle-track-mute(idx); }
                                    toggle-solo => { root.toggle-track-solo(idx); }
                                    toggle-lock => { root.toggle-track-lock(idx); }
                                    delete-track => { root.delete-track(idx); }
                                }
                                // Add-track buttons.
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: root.add-row-height;
                                    add-video := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.add-video-track(); }
                                        Rectangle {
                                            border-radius: Theme.radius-sm;
                                            background: add-video.has-hover ? Palette.accent : #171921;
                                            border-width: 1px;
                                            border-color: Palette.border;
                                            Text {
                                                text: "+V";
                                                color: add-video.has-hover ? white : Palette.text;
                                                font-size: 10px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    add-audio := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.add-audio-track(); }
                                        Rectangle {
                                            border-radius: Theme.radius-sm;
                                            background: add-audio.has-hover ? Palette.success : #171921;
                                            border-width: 1px;
                                            border-color: Palette.border;
                                            Text {
                                                text: "+A";
                                                color: add-audio.has-hover ? white : Palette.text;
                                                font-size: 10px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Right: sticky ruler + scrolling lanes ──
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        // Sticky ruler — scrolls horizontally with the lanes,
                        // stays fixed vertically.
                        Rectangle {
                            height: root.ruler-height;
                            clip: true;
                            ruler-sv := ScrollView {
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                viewport-x <=> root.h-scroll;
                                viewport-width: max(root.total-width + 12px, self.visible-width);
                                viewport-height: root.ruler-height;

                                Rectangle {
                                    width: max(root.total-width + 12px, parent.width);
                                    height: root.ruler-height;
                                    background: #15171d;

                                    Rectangle {
                                        x: 0; y: parent.height - 1px;
                                        width: parent.width; height: 1px;
                                        background: Palette.border;
                                    }

                                    for tick in root.ruler-ticks: Rectangle {
                                        x: tick.x;
                                        y: tick.major ? 12px : 17px;
                                        width: 1px;
                                        height: tick.major ? 13px : 7px;
                                        background: tick.major ? #555965 : #30333c;
                                    }

                                    for tick in root.ruler-ticks: Text {
                                        visible: tick.major;
                                        x: tick.x + 3px;
                                        y: 2px;
                                        text: tick.label;
                                        color: Palette.text-dim;
                                        font-size: 9px;
                                        font-weight: 500;
                                    }

                                    ruler-scrub := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (self.width > 0px) {
                                                root.seek-fraction(self.pressed-x / self.width);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Lane area — scrolls on both axes.
                        lanes-sv := ScrollView {
                            viewport-x <=> root.h-scroll;
                            viewport-y <=> root.v-scroll;
                            viewport-width: max(root.total-width + 12px, self.visible-width);
                            viewport-height: root.stack-height;

                            Rectangle {
                                width: max(root.total-width + 12px, parent.width);
                                height: root.stack-height;
                                background: #0d0e12;

                                // Vertical gridlines aligned with ruler ticks.
                                for tick in root.ruler-ticks: Rectangle {
                                    x: tick.x;
                                    y: 0;
                                    width: 1px;
                                    height: parent.height;
                                    background: tick.major ? #ffffff12 : #ffffff08;
                                }

                                // Per-track lanes, stacked.
                                for track[idx] in root.tracks : TrackLane {
                                    x: 0;
                                    y: root.ruler-offset + idx * (root.lane-height + root.lane-gap);
                                    width: parent.width;
                                    height: root.lane-height;
                                    clips: track.clips;
                                    is-audio: track.is-audio;
                                    muted: track.muted;
                                    interactive: !track.display-only;
                                    accent-color: track.is-audio ? Palette.success : Palette.accent;
                                    selected-id: root.selected-id;
                                    px-per-sec: root.px-per-sec;
                                    drag-from-id: root.drag-from-id;
                                    drop-target-index: root.drop-target-index;
                                    drop-indicator-x: root.drop-indicator-x;
                                    clip-clicked(id)      => { root.clip-clicked(id); }
                                    remove-clicked(id)    => { root.remove-clicked(id); }
                                    drag-started(id)      => { root.drag-started(id); }
                                    drag-moved(id, dx)    => { root.drag-moved(id, dx); }
                                    drag-released(id, dx) => { root.drag-released(id, dx); }
                                    trim-released(id, r, dx) => { root.trim-released(id, r, dx); }
                                    request-split(id)     => { root.request-split(id); }
                                    reveal-in-finder(id)  => { root.reveal-in-finder(id); }
                                    move-to-track(id, t)  => { root.move-to-track(id, t); }
                                }

                                // Drop indicator spans all lanes vertically.
                                if root.drop-target-index >= 0 : DropIndicator {
                                    x: root.drop-indicator-x;
                                    y: root.ruler-offset;
                                    height: root.tracks.length * (root.lane-height + root.lane-gap) - root.lane-gap;
                                }

                                // Playhead spans the lane stack vertically.
                                Rectangle {
                                    visible: root.selected-id != "" && root.total-width > 0px;
                                    x: root.playhead-fraction * parent.width;
                                    y: 0;
                                    width: 1px;
                                    height: parent.height;
                                    background: Palette.accent-2;
                                }
                                Rectangle {
                                    visible: root.selected-id != "" && root.total-width > 0px;
                                    x: root.playhead-fraction * parent.width - 3px;
                                    y: 0;
                                    width: 7px;
                                    height: 5px;
                                    background: Palette.accent-2;
                                    border-radius: 1px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
