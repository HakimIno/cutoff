import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { SpeakerIcon, SpeakerMutedIcon, EyeLineIcon, EyeOffLineIcon, LockClosedIcon, LockOpenIcon } from "icons.slint";

// A small square icon toggle used in the track header (mute / lock).
component ChipToggle inherits Rectangle {
    in property <bool> active;
    in property <color> active-color: Palette.danger;
    in property <string> label: "";
    out property <bool> has-hover: ta.has-hover;
    callback clicked();
    width: 22px;
    height: 18px;
    border-radius: 3px;
    background: root.active
        ? root.active-color
        : (ta.has-hover ? Palette.surface-3 : #101116);
    border-width: 1px;
    border-color: root.active ? root.active-color.brighter(0.25) : Palette.border;
    animate background { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.label != "" : Text {
        text: root.label;
        color: root.active ? white : (ta.has-hover ? Palette.text : Palette.text-dim);
        font-size: 9px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    @children
}

/// Horizontal left-rail header for one timeline track: name + visibility/mute
/// and lock toggles (DaVinci / CapCut style).
export component TrackHeader inherits Rectangle {
    in property <string> label;
    in property <int> clip-count: 0;
    in property <bool> is-audio: false;
    in property <color> badge-color: Palette.accent;
    in property <bool> muted;
    in property <bool> soloed;
    in property <bool> locked;
    in property <bool> deletable: true;

    callback toggle-mute();
    callback toggle-solo();
    callback toggle-lock();
    callback delete-track();

    property <string> display-label:
        root.label == "V1" ? "Video 1" :
        root.label == "V2" ? "Video 2" :
        root.label == "A1" ? "Audio 1" :
        root.label == "A2" ? "Audio 2" :
        root.label;

    background: root.muted ? Palette.danger-soft : #15171d;
    border-radius: 2px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    Rectangle {
        width: 2px;
        height: 100%;
        background: root.badge-color;
        opacity: root.muted ? 0.45 : 0.9;
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 7px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.display-label;
                color: root.locked ? Palette.text-muted : Palette.text;
                font-size: 10px;
                font-weight: 800;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.clip-count + (root.clip-count == 1 ? " Clip" : " Clips");
                color: Palette.text-dim;
                font-size: 8px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 4px;

            ChipToggle {
                label: root.is-audio ? "A1" : "V1";
                active: true;
                active-color: root.badge-color;
            }

            // Visibility (video) / mute (audio)
            mute := ChipToggle {
                active: root.muted;
                active-color: Palette.danger;
                clicked => { root.toggle-mute(); }
                if root.is-audio && !root.muted : SpeakerIcon {
                    icon-color: mute.has-hover ? white : Palette.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if root.is-audio && root.muted : SpeakerMutedIcon {
                    icon-color: white;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if !root.is-audio && !root.muted : EyeLineIcon {
                    icon-color: mute.has-hover ? white : Palette.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if !root.is-audio && root.muted : EyeOffLineIcon {
                    icon-color: white;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            ChipToggle {
                label: "S";
                active: root.soloed;
                active-color: Palette.accent;
                clicked => { root.toggle-solo(); }
            }

            // Lock
            lock := ChipToggle {
                active: root.locked;
                active-color: Palette.text-muted;
                clicked => { root.toggle-lock(); }
                if !root.locked : LockOpenIcon {
                    icon-color: lock.has-hover ? white : Palette.text-dim;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if root.locked : LockClosedIcon {
                    icon-color: white;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Right-click → Delete this track. Only enabled when `deletable`.
    if root.deletable : ContextMenuArea {
        Menu {
            MenuItem {
                title: "Delete track \"" + root.label + "\"";
                activated => { root.delete-track(); }
            }
        }
    }
}
