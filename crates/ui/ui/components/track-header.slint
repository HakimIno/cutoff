import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { SpeakerIcon, SpeakerMutedIcon, LockClosedIcon, LockOpenIcon } from "icons.slint";

/// Left-edge label + mute/lock chips for a single timeline track.
export component TrackHeader inherits Rectangle {
    in property <string> label;
    in property <color> badge-color: Palette.accent;
    in property <bool> muted;
    in property <bool> soloed;
    in property <bool> locked;

    callback toggle-mute();
    callback toggle-solo();
    callback toggle-lock();

    width: 56px;
    background: Palette.surface-2;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: Theme.radius-sm;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;
        alignment: center;

        // Track badge
        Rectangle {
            width: 28px; height: 18px;
            border-radius: Theme.radius-sm;
            background: root.badge-color;
            x: (parent.width - self.width) / 2;
            Text {
                text: root.label;
                color: white;
                font-size: Theme.font-xs;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Controls row
        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            // Mute Button (Speaker)
            mute-ta := TouchArea {
                mouse-cursor: pointer;
                width: 16px; height: 16px;
                clicked => { root.toggle-mute(); }
                Rectangle {
                    border-radius: 2px;
                    background: root.muted
                        ? Palette.danger
                        : (mute-ta.has-hover ? Palette.surface-3 : transparent);
                    border-width: 1px;
                    border-color: root.muted ? Palette.danger : Palette.border;

                    if !root.muted : SpeakerIcon {
                        icon-color: mute-ta.has-hover ? white : Palette.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.muted : SpeakerMutedIcon {
                        icon-color: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Solo Button (S)
            solo-ta := TouchArea {
                mouse-cursor: pointer;
                width: 16px; height: 16px;
                clicked => { root.toggle-solo(); }
                Rectangle {
                    border-radius: 2px;
                    background: root.soloed
                        ? Palette.warning
                        : (solo-ta.has-hover ? Palette.surface-3 : transparent);
                    border-width: 1px;
                    border-color: root.soloed ? Palette.warning : Palette.border;
                    Text {
                        text: "S";
                        color: root.soloed ? white : Palette.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Lock Button (Padlock)
            lock-ta := TouchArea {
                mouse-cursor: pointer;
                width: 16px; height: 16px;
                clicked => { root.toggle-lock(); }
                Rectangle {
                    border-radius: 2px;
                    background: root.locked
                        ? Palette.text-muted
                        : (lock-ta.has-hover ? Palette.surface-3 : transparent);
                    border-width: 1px;
                    border-color: root.locked ? Palette.text-muted : Palette.border;

                    if !root.locked : LockOpenIcon {
                        icon-color: lock-ta.has-hover ? white : Palette.text-dim;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.locked : LockClosedIcon {
                        icon-color: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}
