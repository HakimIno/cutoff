import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { WaveformStrip } from "waveform-strip.slint";
import { CloseIcon } from "icons.slint";

export struct ClipData {
    id: string,
    name: string,
    duration: string,
    resolution: string,
    duration-secs: float,
    thumbnails: [image],
    waveform-peaks: [float],
    muted: bool,
    video-track: int,
}

component IconAction inherits Rectangle {
    in property <bool> dim: false;
    in property <color> hover-color: Palette.accent;
    callback clicked();
    width: 20px; height: 20px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? hover-color : Palette.surface-3;
    opacity: dim && !ta.has-hover ? 0.6 : 1.0;
    animate background { duration: 100ms; }
    animate opacity { duration: 100ms; }

    ta := TouchArea { clicked => { root.clicked(); } }
    CloseIcon {
        icon-color: ta.has-hover ? white : Palette.text;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component ClipBlock inherits Rectangle {
    in property <ClipData> data;
    in property <int> index;
    in property <bool> selected;
    in property <length> px-per-sec: 6px;
    in property <bool> drag-ghost: false;

    callback clip-clicked(string);
    callback remove-clicked(string);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);  // (id, is_right_handle, delta_px)
    callback request-split(string);
    callback reveal-in-finder(string);
    callback move-to-track(string, int);

    width: max(min(self.px-per-sec * root.data.duration-secs, 800px), 120px);
    height: 76px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.selected ? Palette.accent : (drag-area.has-hover ? Palette.border-bright : Palette.border);
    background: root.selected
        ? Palette.accent-glow
        : (drag-area.has-hover ? Palette.surface-3 : Palette.surface-2);
    clip: true;
    opacity: root.drag-ghost ? 0.35 : 1.0;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    animate opacity { duration: 120ms; }

    // ── Layer 0 (bottom): drag/click TouchArea covers the whole card.
    // Interactive children declared after this win the z-order battle.
    drag-area := TouchArea {
        mouse-cursor: dragging ? grabbing : grab;
        property <bool> dragging: false;
        property <length> drag-threshold: 4px;

        clicked => {
            if (!self.dragging) {
                root.clip-clicked(root.data.id);
            }
        }
        moved => {
            if (self.pressed && !self.dragging
                && (abs(self.mouse-x - self.pressed-x) > self.drag-threshold)) {
                self.dragging = true;
                root.drag-started(root.data.id);
            }
            if (self.dragging) {
                root.drag-moved(root.data.id, self.mouse-x - self.pressed-x);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && self.dragging) {
                root.drag-released(root.data.id, self.mouse-x - self.pressed-x);
                self.dragging = false;
            }
        }
    }

    // ── Layer 1: right-click context menu (whole-card right-click target).
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Split at playhead";
                activated => { root.request-split(root.data.id); }
            }
            MenuItem {
                title: "Move to V2";
                activated => { root.move-to-track(root.data.id, 1); }
            }
            MenuItem {
                title: "Move to V1";
                activated => { root.move-to-track(root.data.id, 0); }
            }
            MenuItem {
                title: "Move to A1";
                activated => { root.move-to-track(root.data.id, 2); }
            }
            MenuItem {
                title: "Move to A2";
                activated => { root.move-to-track(root.data.id, 3); }
            }
            MenuItem {
                title: "Delete clip";
                activated => { root.remove-clicked(root.data.id); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Reveal in Finder";
                activated => { root.reveal-in-finder(root.data.id); }
            }
        }
    }

    // ── Layer 2: visual content (selection stripe, filmstrip, waveform, labels).
    // Plain Rectangles/Texts don't capture pointer events, so the drag-area
    // underneath still receives clicks on empty card body.
    if root.selected : Rectangle {
        x: 0; y: 0;
        width: 3px; height: 100%;
        background: Palette.accent;
        border-radius: 1px;
    }

    Rectangle {
        x: 0;
        y: 20px;
        width: parent.width;
        height: 28px;
        clip: true;
        background: #000000;

        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            for thumb[i] in root.data.thumbnails: Image {
                source: thumb;
                width: parent.width / max(root.data.thumbnails.length, 1);
                height: 28px;
                image-fit: cover;
            }
        }
    }

    Rectangle {
        x: 0;
        y: 48px;
        width: parent.width;
        height: 12px;
        background: Palette.surface;
        opacity: root.data.muted ? 0.4 : 1.0;
        WaveformStrip {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            peaks: root.data.waveform-peaks;
        }
    }

    HorizontalLayout {
        x: Theme.spacing-sm;
        y: 4px;
        width: parent.width - 2 * Theme.spacing-sm;
        spacing: Theme.spacing-sm;
        alignment: start;
        Rectangle {
            width: 18px; height: 16px;
            border-radius: Theme.radius-sm;
            background: root.selected ? Palette.accent : Palette.surface-3;
            Text {
                text: root.index + 1;
                color: Palette.text;
                font-size: Theme.font-xs;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.data.name;
            color: Palette.text;
            font-size: Theme.font-xs;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    Text {
        x: Theme.spacing-sm;
        y: parent.height - self.height - 4px;
        text: root.data.duration;
        color: Palette.text-muted;
        font-size: Theme.font-xs;
        font-weight: 600;
    }

    // ── Layer 3 (TOP): interactive controls. These TouchAreas are declared
    // *after* drag-area so they take pointer priority within their bounds.

    left-trim := TouchArea {
        x: 0;
        y: 0;
        width: 6px;
        height: parent.height;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && self.has-hover) {
                root.trim-released(root.data.id, false, self.mouse-x - self.pressed-x);
            }
        }
    }
    if left-trim.has-hover || left-trim.pressed : Rectangle {
        x: 0; y: 0;
        width: 1px; height: parent.height;
        background: white;
    }

    right-trim := TouchArea {
        x: parent.width - 6px;
        y: 0;
        width: 6px;
        height: parent.height;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && self.has-hover) {
                root.trim-released(root.data.id, true, self.mouse-x - self.pressed-x);
            }
        }
    }
    if right-trim.has-hover || right-trim.pressed : Rectangle {
        x: parent.width - 1px; y: 0;
        width: 1px; height: parent.height;
        background: white;
    }

    // Close (×) button absolutely positioned bottom-right, ON TOP of drag-area.
    IconAction {
        x: parent.width - self.width - Theme.spacing-xs;
        y: parent.height - self.height - 4px;
        dim: !drag-area.has-hover && !root.selected;
        hover-color: Palette.danger;
        clicked => { root.remove-clicked(root.data.id); }
    }
}
