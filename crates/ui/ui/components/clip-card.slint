import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { CloseIcon } from "icons.slint";
import { WaveformStrip } from "waveform-strip.slint";

export struct ClipData {
    id: string,
    name: string,
    duration: string,
    resolution: string,
    duration-secs: float,
    start-secs: float,
    thumbnails: [image],
    waveform-peaks: [float],
    waveform-mins: [float],
    waveform-maxs: [float],
    muted: bool,
    video-track: int,
}

component IconAction inherits Rectangle {
    in property <bool> dim: false;
    in property <color> hover-color: Palette.accent;
    callback clicked();
    width: 20px; height: 20px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? hover-color : Palette.surface-3;
    opacity: dim && !ta.has-hover ? 0.6 : 1.0;
    animate background { duration: 100ms; }
    animate opacity { duration: 100ms; }

    ta := TouchArea { clicked => { root.clicked(); } }
    CloseIcon {
        icon-color: ta.has-hover ? white : Palette.text;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component ClipBlock inherits Rectangle {
    in property <ClipData> data;
    in property <int> index;
    in property <bool> selected;
    in property <length> px-per-sec: 6px;
    in property <bool> drag-ghost: false;
    in property <bool> interactive: true;

    callback clip-clicked(string);
    callback remove-clicked(string);
    callback drag-started(string);
    callback drag-moved(string, length);
    callback drag-released(string, length);
    callback trim-released(string, bool, length);  // (id, is_right_handle, delta_px)
    callback request-split(string);
    callback reveal-in-finder(string);
    callback move-to-track(string, int);

    // Compact editor-style clip card. `accent-color` is the track colour and
    // `is-audio` switches the metadata hint.
    in property <color> accent-color: Palette.accent;
    in property <bool> is-audio: false;

    // Width scales linearly with the zoom (px-per-sec) so cards track the ruler
    // exactly and zooming in/out actually resizes them. Floor at 24px keeps a
    // very short clip clickable. Keep in sync with `card_width` in Rust.
    width: max(self.px-per-sec * root.data.duration-secs, 44px);
    height: 38px;
    border-radius: 3px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.is-audio
        ? (root.selected ? #ffffff : (drag-area.has-hover ? #ffffffee : #ffffffcc))
        : (root.selected
            ? root.accent-color.brighter(0.55)
            : (drag-area.has-hover ? root.accent-color.with-alpha(0.7) : root.accent-color.with-alpha(0.45)));
    background: root.is-audio
        ? (drag-area.has-hover ? #48a85e : #52b86a)
        : (drag-area.has-hover ? #20242d : #171920);
    clip: true;
    opacity: root.drag-ghost ? 0.4 : (root.data.muted ? 0.6 : 1.0);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    animate opacity { duration: 120ms; }

    // ── Layer 0 (bottom): drag/click TouchArea covers the whole card.
    // Interactive children declared after this win the z-order battle.
    drag-area := TouchArea {
        enabled: root.interactive;
        mouse-cursor: dragging ? grabbing : grab;
        property <bool> dragging: false;
        property <length> drag-threshold: 4px;

        clicked => {
            if (!self.dragging) {
                root.clip-clicked(root.data.id);
            }
        }
        moved => {
            if (self.pressed && !self.dragging
                && (abs(self.mouse-x - self.pressed-x) > self.drag-threshold)) {
                self.dragging = true;
                root.drag-started(root.data.id);
            }
            if (self.dragging) {
                root.drag-moved(root.data.id, self.mouse-x - self.pressed-x);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && self.dragging) {
                root.drag-released(root.data.id, self.mouse-x - self.pressed-x);
                self.dragging = false;
            }
        }
    }

    // ── Layer 1: right-click context menu (whole-card right-click target).
    if root.interactive : ContextMenuArea {
        Menu {
            MenuItem {
                title: "Split at playhead";
                activated => { root.request-split(root.data.id); }
            }
            MenuItem {
                title: "Move to V2";
                activated => { root.move-to-track(root.data.id, 1); }
            }
            MenuItem {
                title: "Move to V1";
                activated => { root.move-to-track(root.data.id, 0); }
            }
            MenuItem {
                title: "Move to A1";
                activated => { root.move-to-track(root.data.id, 2); }
            }
            MenuItem {
                title: "Move to A2";
                activated => { root.move-to-track(root.data.id, 3); }
            }
            MenuItem {
                title: "Delete clip";
                activated => { root.remove-clicked(root.data.id); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Reveal in Finder";
                activated => { root.reveal-in-finder(root.data.id); }
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 2px;
        background: root.accent-color;
    }

    if !root.is-audio && root.data.thumbnails.length > 0 : Rectangle {
        y: 2px;
        width: 100%;
        height: parent.height - 2px;
        clip: true;
        property <length> thumb-cell-width: parent.width / max(root.data.thumbnails.length, 1);
        for thumb[i] in root.data.thumbnails: Image {
            x: i * parent.thumb-cell-width;
            width: parent.thumb-cell-width + 1px;
            height: 100%;
            source: thumb;
            image-fit: cover;
            opacity: 0.96;
        }
        Rectangle {
            background: @linear-gradient(180deg, #00000033 0%, #00000000 42%, #000000cc 100%);
        }
    }

    if root.is-audio : Rectangle {
        width: 100%;
        height: 100%;
        background: #52b86a;
        if root.data.waveform-maxs.length > 0 : WaveformStrip {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            mins: root.data.waveform-mins;
            maxs: root.data.waveform-maxs;
            fill-color: #e8f8ec;
        }
        if root.data.waveform-maxs.length == 0 : Rectangle {
            y: parent.height / 2;
            width: parent.width;
            height: 1px;
            background: #e8f8ec88;
        }
    }

    if !root.is-audio : Rectangle {
        y: parent.height - 15px;
        width: 100%;
        height: 15px;
        background: #000000aa;
    }

    // ── Layer 2: visual content — compact label + secondary metadata.
    // Plain Rectangles/Texts don't capture pointer events, so the drag-area
    // underneath still receives clicks on the empty card body.
    if root.width >= 40px : Rectangle {
        x: 6px;
        y: root.is-audio ? 5px : parent.height - 14px;
        width: parent.width - 12px;
        height: root.is-audio ? 12px : 13px;
        clip: true;
        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.data.name;
                color: white;
                font-size: 9px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // ── Layer 3 (TOP): interactive controls. These TouchAreas are declared
    // *after* drag-area so they take pointer priority within their bounds.

    left-trim := TouchArea {
        enabled: root.interactive;
        x: 0;
        y: 0;
        width: 6px;
        height: parent.height;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && self.has-hover) {
                root.trim-released(root.data.id, false, self.mouse-x - self.pressed-x);
            }
        }
    }
    if left-trim.has-hover || left-trim.pressed : Rectangle {
        x: 0; y: 0;
        width: 1px; height: parent.height;
        background: white;
    }

    right-trim := TouchArea {
        enabled: root.interactive;
        x: parent.width - 6px;
        y: 0;
        width: 6px;
        height: parent.height;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && self.has-hover) {
                root.trim-released(root.data.id, true, self.mouse-x - self.pressed-x);
            }
        }
    }
    if right-trim.has-hover || right-trim.pressed : Rectangle {
        x: parent.width - 1px; y: 0;
        width: 1px; height: parent.height;
        background: white;
    }

    // Close (×) button, top-right, shown only on hover/selection so the bar
    // stays clean otherwise.
    if root.interactive && root.width >= 50px && (drag-area.has-hover || root.selected) : IconAction {
        x: parent.width - self.width - 4px;
        y: 4px;
        hover-color: Palette.danger;
        clicked => { root.remove-clicked(root.data.id); }
    }
}
