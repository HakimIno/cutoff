import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { PlayIcon, PauseIcon, SkipStartIcon, SkipEndIcon, StepForwardIcon, StepBackwardIcon } from "icons.slint";

component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled-state: true;
    callback clicked();
    width: 28px; height: 28px;
    border-radius: 14px;
    opacity: root.enabled-state ? 1.0 : 0.4;
    background: ta.has-hover && root.enabled-state ? Palette.accent-2 : Palette.accent;
    animate background { duration: 120ms; }
    animate opacity { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled-state;
        clicked => { root.clicked(); }
    }

    if !root.playing : PlayIcon {
        icon-color: white;
        x: (parent.width - self.width) / 2 + 1px;
        y: (parent.height - self.height) / 2;
    }
    if root.playing : PauseIcon {
        icon-color: white;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component DeckButton inherits Rectangle {
    in property <bool> enabled-state: true;
    out property <bool> has-hover: ta.has-hover;
    callback clicked();
    width: 26px; height: 26px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover && root.enabled-state ? Palette.surface-3 : Palette.surface-2;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled-state ? Palette.border-bright : Palette.border;
    opacity: root.enabled-state ? 1.0 : 0.4;
    animate background { duration: 100ms; }
    animate opacity { duration: 100ms; }

    ta := TouchArea {
        enabled: root.enabled-state;
        clicked => { root.clicked(); }
    }
}

export component PreviewPanel inherits Rectangle {
    in property <bool> has-selection;
    in property <string> selected-name;
    in property <string> selected-resolution;
    in property <string> selected-duration;
    in property <string> playhead-text: "00:00";
    in property <image> frame;
    in property <bool> playing;

    in property <int> project-width: 1920;
    in property <int> project-height: 1080;
    in property <int> selected-width: 1920;
    in property <int> selected-height: 1080;
    in property <float> selected-scale: 1.0;
    in property <int> selected-position-x: 0;
    in property <int> selected-position-y: 0;
    in property <float> selected-scale-x: 1.0;
    in property <float> selected-scale-y: 1.0;
    in property <float> selected-rotation: 0.0;

    callback play-toggle();
    callback step-frame(int);
    callback jump-start();
    callback jump-end();

    callback scale-changed(float);
    callback position-x-changed(int);
    callback position-y-changed(int);
    callback scale-x-changed(float);
    callback scale-y-changed(float);
    callback rotation-changed(float);
    // Fired once at the start of a drag so the bridge can checkpoint undo.
    callback transform-gesture-begin();

    background: Palette.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Screen area
        Rectangle {
            background: #000000;
            vertical-stretch: 1;
            clip: true;

            // nw and nh as float/lengths
            property <length> nw: root.project-width * 1px;
            property <length> nh: root.project-height * 1px;
            
            // Aspect ratio of the project
            property <float> aspect: root.project-height > 0 ? (root.project-width / root.project-height) : 16.0 / 9.0;
            
            // The display width and height of the video canvas container inside the image boundary
            property <length> disp-w: (img.height > 0px && (img.width / img.height) > aspect) ? img.height * aspect : img.width;
            property <length> disp-h: (img.height > 0px && (img.width / img.height) > aspect) ? img.height : (aspect > 0 ? img.width / aspect : img.width);
            
            // Center offsets of the video canvas container relative to the Image widget
            property <length> disp-x: (img.width - disp-w) / 2;
            property <length> disp-y: (img.height - disp-h) / 2;

            property <float> scale-factor: (nw > 0px && nh > 0px) ? (disp-w / nw) : 1.0;

            // Effective per-axis scale = uniform × per-axis (matches ResolvedTransform).
            property <float> eff-sx: root.selected-scale * root.selected-scale-x;
            property <float> eff-sy: root.selected-scale * root.selected-scale-y;

            property <length> clip-w: root.selected-width * eff-sx * 1px * scale-factor;
            property <length> clip-h: root.selected-height * eff-sy * 1px * scale-factor;

            property <length> clip-x: disp-x + (root.selected-position-x * 1px + (nw - root.selected-width * eff-sx * 1px) / 2) * scale-factor;
            property <length> clip-y: disp-y + (root.selected-position-y * 1px + (nh - root.selected-height * eff-sy * 1px) / 2) * scale-factor;

            // Live frame (visible only when selection has produced a frame)
            img := Image {
                visible: root.has-selection;
                source: root.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            // Overlay borders and handles
            if root.has-selection : Rectangle {
                x: clip-x;
                y: clip-y;
                width: clip-w;
                height: clip-h;
                border-width: 1.5px;
                border-color: Palette.accent; // System primary color accent boundary

                // Rotation handle — a dot above the top edge.
                Rectangle {
                    x: (parent.width - 10px) / 2; y: -26px;
                    width: 10px; height: 10px;
                    background: Palette.accent;
                    border-width: 1.5px;
                    border-color: white;
                    border-radius: 5px;
                }
                Rectangle { // stem connecting the rotation dot to the box
                    x: (parent.width - 1px) / 2; y: -21px;
                    width: 1px; height: 21px;
                    background: Palette.accent;
                }

                // Corners
                // Top-Left
                Rectangle {
                    x: -4px; y: -4px;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Top-Right
                Rectangle {
                    x: parent.width - 4px; y: -4px;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Bottom-Left
                Rectangle {
                    x: -4px; y: parent.height - 4px;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Bottom-Right
                Rectangle {
                    x: parent.width - 4px; y: parent.height - 4px;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Top-Center
                Rectangle {
                    x: (parent.width - 8px) / 2; y: -4px;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Bottom-Center
                Rectangle {
                    x: (parent.width - 8px) / 2; y: parent.height - 4px;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Left-Center
                Rectangle {
                    x: -4px; y: (parent.height - 8px) / 2;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
                // Right-Center
                Rectangle {
                    x: parent.width - 4px; y: (parent.height - 8px) / 2;
                    width: 8px; height: 8px;
                    background: white;
                    border-width: 1.5px;
                    border-color: Palette.accent;
                    border-radius: 1px;
                }
            }

            // Global TouchArea covering the screen area for hit-testing and dragging
            if root.has-selection : overlay-ta := TouchArea {
                width: 100%;
                height: 100%;

                property <bool> is-dragging: false;
                property <string> drag-type; // "move" | "scale" | "scale-x" | "scale-y" | "rotate"

                property <length> start-mouse-x;
                property <length> start-mouse-y;
                property <float> start-scale;
                property <float> start-scale-x;
                property <float> start-scale-y;
                property <float> start-rotation;
                property <float> start-angle-deg;
                property <int> start-pos-x;
                property <int> start-pos-y;

                property <length> center-x: clip-x + clip-w / 2;
                property <length> center-y: clip-y + clip-h / 2;
                property <length> start-dist;
                property <length> start-hdist;
                property <length> start-vdist;

                property <length> thresh: 12px;

                // The selection box is drawn axis-aligned (Slint Rectangle can't
                // rotate), so hit-test against plain cursor coordinates. The
                // video content itself is rotated by the compositor.
                property <length> lmx: self.mouse-x;
                property <length> lmy: self.mouse-y;

                // Rotation handle sits 26px above the top edge.
                property <bool> near-rot: abs(self.lmx - self.center-x) < self.thresh && abs(self.lmy - (clip-y - 26px)) < self.thresh;

                property <bool> near-tl: abs(self.lmx - clip-x) < self.thresh && abs(self.lmy - clip-y) < self.thresh;
                property <bool> near-tr: abs(self.lmx - (clip-x + clip-w)) < self.thresh && abs(self.lmy - clip-y) < self.thresh;
                property <bool> near-bl: abs(self.lmx - clip-x) < self.thresh && abs(self.lmy - (clip-y + clip-h)) < self.thresh;
                property <bool> near-br: abs(self.lmx - (clip-x + clip-w)) < self.thresh && abs(self.lmy - (clip-y + clip-h)) < self.thresh;

                property <bool> near-corner: self.near-tl || self.near-tr || self.near-bl || self.near-br;
                property <bool> near-t: abs(self.lmx - (clip-x + clip-w/2)) < self.thresh && abs(self.lmy - clip-y) < self.thresh;
                property <bool> near-b: abs(self.lmx - (clip-x + clip-w/2)) < self.thresh && abs(self.lmy - (clip-y + clip-h)) < self.thresh;
                property <bool> near-l: abs(self.lmx - clip-x) < self.thresh && abs(self.lmy - (clip-y + clip-h/2)) < self.thresh;
                property <bool> near-r: abs(self.lmx - (clip-x + clip-w)) < self.thresh && abs(self.lmy - (clip-y + clip-h/2)) < self.thresh;

                property <bool> inside-box: self.lmx >= clip-x && self.lmx <= clip-x + clip-w && self.lmy >= clip-y && self.lmy <= clip-y + clip-h;

                mouse-cursor: self.is-dragging ? (
                    self.drag-type == "rotate" ? MouseCursor.crosshair : (
                        self.drag-type == "move" ? MouseCursor.move : MouseCursor.nesw-resize)) : (
                    self.near-rot ? MouseCursor.crosshair : (
                        self.near-tl || self.near-br ? MouseCursor.nwse-resize : (
                            self.near-tr || self.near-bl ? MouseCursor.nesw-resize : (
                                self.near-t || self.near-b ? MouseCursor.ns-resize : (
                                    self.near-l || self.near-r ? MouseCursor.ew-resize : (
                                        self.inside-box ? MouseCursor.move : MouseCursor.default
                                    )
                                )
                            )
                        )
                    )
                );

                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        if (self.near-rot || self.near-corner || self.near-t || self.near-b || self.near-l || self.near-r || self.inside-box) {
                            self.is-dragging = true;
                            self.start-scale = root.selected-scale;
                            self.start-scale-x = root.selected-scale-x;
                            self.start-scale-y = root.selected-scale-y;
                            self.start-rotation = root.selected-rotation;
                            self.start-pos-x = root.selected-position-x;
                            self.start-pos-y = root.selected-position-y;
                            self.start-mouse-x = self.mouse-x;
                            self.start-mouse-y = self.mouse-y;
                            self.start-angle-deg = Math.atan2((self.mouse-y - self.center-y) / 1px, (self.mouse-x - self.center-x) / 1px) / 1deg;
                            self.start-dist = Math.sqrt((self.lmx - self.center-x) / 1px * ((self.lmx - self.center-x) / 1px) + (self.lmy - self.center-y) / 1px * ((self.lmy - self.center-y) / 1px)) * 1px;
                            self.start-hdist = abs(self.lmx - self.center-x);
                            self.start-vdist = abs(self.lmy - self.center-y);

                            self.drag-type =
                                self.near-rot ? "rotate" : (
                                    self.near-corner ? "scale" : (
                                        self.near-t || self.near-b ? "scale-y" : (
                                            self.near-l || self.near-r ? "scale-x" : "move")));
                            root.transform-gesture-begin();
                        }
                    } else if (e.kind == PointerEventKind.up) {
                        self.is-dragging = false;
                    }
                }

                moved => {
                    if (self.is-dragging && self.pressed) {
                        if (self.drag-type == "scale") {
                            let dx = (self.lmx - self.center-x) / 1px;
                            let dy = (self.lmy - self.center-y) / 1px;
                            let curr-dist = Math.sqrt(dx * dx + dy * dy);
                            let d-start = self.start-dist / 1px;
                            if (d-start > 0.0) {
                                root.scale-changed(max(0.1, min(2.0, self.start-scale * (curr-dist / d-start))));
                            }
                        } else if (self.drag-type == "scale-x") {
                            let d-start = self.start-hdist / 1px;
                            if (d-start > 0.0) {
                                let curr = abs(self.lmx - self.center-x) / 1px;
                                root.scale-x-changed(max(0.05, min(4.0, self.start-scale-x * (curr / d-start))));
                            }
                        } else if (self.drag-type == "scale-y") {
                            let d-start = self.start-vdist / 1px;
                            if (d-start > 0.0) {
                                let curr = abs(self.lmy - self.center-y) / 1px;
                                root.scale-y-changed(max(0.05, min(4.0, self.start-scale-y * (curr / d-start))));
                            }
                        } else if (self.drag-type == "rotate") {
                            let curr-angle = Math.atan2((self.mouse-y - self.center-y) / 1px, (self.mouse-x - self.center-x) / 1px) / 1deg;
                            root.rotation-changed(self.start-rotation + (curr-angle - self.start-angle-deg));
                        } else if (self.drag-type == "move") {
                            let dx-proj = ((self.mouse-x - self.start-mouse-x) / 1px) * (nw / disp-w);
                            let dy-proj = ((self.mouse-y - self.start-mouse-y) / 1px) * (nh / disp-h);
                            root.position-x-changed(self.start-pos-x + Math.round(dx-proj));
                            root.position-y-changed(self.start-pos-y + Math.round(dy-proj));
                        }
                    }
                }
            }

            // Empty state — full-screen overlay, centered in the preview area
            if !root.has-selection : Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: Theme.spacing-sm;

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        alignment: center;
                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.spacing-sm;

                            Rectangle {
                                width: 56px;
                                height: 56px;
                                horizontal-stretch: 0;
                                border-radius: 28px;
                                background: Palette.surface-2;
                                PlayIcon {
                                    icon-color: Palette.text-dim;
                                    width: 22px;
                                    height: 22px;
                                    x: (parent.width - self.width) / 2 + 1px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Text {
                                text: "Select a clip to preview";
                                color: Palette.text-dim;
                                font-size: Theme.font-md;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Press  Space  to play once loaded";
                                color: Palette.text-dim;
                                font-size: Theme.font-xs;
                                horizontal-alignment: center;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        // Player chrome bar (Hardware Deck style)
        Rectangle {
            height: 44px;
            background: Palette.surface-2;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-md;
                alignment: space-between;

                // Timecode
                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    alignment: start;
                    Text {
                        text: root.playhead-text;
                        color: Palette.accent-2;
                        font-size: Theme.font-sm;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: " / " + (root.has-selection ? root.selected-duration : "00:00");
                        color: Palette.text-muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                }

                // Transport Controls
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 4px;
                    alignment: center;
                    btn-start := DeckButton {
                        enabled-state: root.has-selection;
                        clicked => { root.jump-start(); }
                        SkipStartIcon {
                            icon-color: btn-start.has-hover ? white : Palette.text;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    btn-back := DeckButton {
                        enabled-state: root.has-selection;
                        clicked => { root.step-frame(-1); }
                        StepBackwardIcon {
                            icon-color: btn-back.has-hover ? white : Palette.text;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    PlayButton {
                        playing: root.playing;
                        enabled-state: root.has-selection;
                        clicked => { root.play-toggle(); }
                    }
                    btn-fwd := DeckButton {
                        enabled-state: root.has-selection;
                        clicked => { root.step-frame(1); }
                        StepForwardIcon {
                            icon-color: btn-fwd.has-hover ? white : Palette.text;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    btn-end := DeckButton {
                        enabled-state: root.has-selection;
                        clicked => { root.jump-end(); }
                        SkipEndIcon {
                            icon-color: btn-end.has-hover ? white : Palette.text;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Metadata badge
                Rectangle {
                    background: Palette.surface-3;
                    border-radius: Theme.radius-sm;
                    height: 24px;
                    width: self.preferred-width + 12px;
                    y: (parent.height - self.height) / 2;
                    Text {
                        text: root.has-selection ? root.selected-resolution : "—";
                        color: Palette.text-muted;
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
