import { Palette } from "../styles/palette.slint";

/// Filled symmetric envelope (adjacent buckets, reads as one smooth shape on Slint 1.16).
export component WaveformStrip inherits Rectangle {
    in property <[float]> mins;
    in property <[float]> maxs;
    in property <color> fill-color: Palette.accent-2;

    clip: true;
    background: transparent;

    if root.maxs.length > 0 && root.mins.length > 0 : Rectangle {
        width: 100%;
        height: 100%;
        for hi[i] in root.maxs: Rectangle {
            property <float> lo: i < root.mins.length ? root.mins[i] : -hi;
            property <float> top-value: min(1, max(-1, hi));
            property <float> bottom-value: min(1, max(-1, self.lo));
            property <length> bucket-width: parent.width / max(root.maxs.length, 1);
            property <length> top-y: parent.height * (0.5 - self.top-value * 0.5);
            property <length> bottom-y: parent.height * (0.5 - self.bottom-value * 0.5);
            x: i * self.bucket-width;
            y: min(self.top-y, self.bottom-y);
            width: self.bucket-width + 1px;
            height: max(abs(self.bottom-y - self.top-y), 1px);
            background: root.fill-color;
        }
    }
}
