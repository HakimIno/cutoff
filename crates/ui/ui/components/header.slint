import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";
import { ColorPickerPro } from "color-picker-pro.slint";

// A single row inside a dropdown menu.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    callback activated();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Palette.surface-3 : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 24px;
        alignment: space-between;
        Text {
            text: root.label;
            color: Palette.text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.shortcut;
            color: Palette.text-dim;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
}

// A small top-bar menu label that opens a dropdown of @children rows.
component MenuButton inherits Rectangle {
    in property <string> label;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Palette.surface-2 : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            color: ta.has-hover ? Palette.text : Palette.text-muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        Rectangle {
            width: 220px;
            height: content.preferred-height;
            background: Palette.surface-2;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: Theme.radius;
            drop-shadow-blur: 22px;
            drop-shadow-color: #00000077;
            content := VerticalLayout {
                padding: 5px;
                @children
            }
        }
    }
}

// Ghost (outlined) button for secondary header actions.
component GhostButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 26px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.border-bright : Palette.border;
    background: ta.has-hover ? Palette.surface-2 : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            color: Palette.text;
            font-size: Theme.font-sm;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Header inherits Rectangle {
    in property <string> project-name: "Untitled Project";
    in property <bool> can-export: false;
    in property <bool> exporting: false;
    property <color> preview-color: #ffffff;
    property <string> preview-hex: "#ffffff";

    callback export-clicked();
    callback save-project();
    callback load-project();
    callback undo();
    callback redo();
    callback zoom-in();
    callback zoom-out();

    height: 42px;
    background: Palette.surface;

    // Bottom hairline divider
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Palette.border;
    }

    // Centered project name (overlay so left/right clusters don't shift it)
    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.project-name;
        color: Palette.text-muted;
        font-size: Theme.font-sm;
        font-weight: 500;
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-sm;
        alignment: space-between;

        // ── Left: brand + menus ──
        HorizontalLayout {
            spacing: 2px;
            alignment: start;

            // Brand mark
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: Palette.accent;
                y: (parent.height - self.height) / 2;
                Text {
                    text: "▶";
                    color: white;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { width: 6px; }

            MenuButton {
                label: "File";
                y: (parent.height - self.height) / 2;
                MenuRow {
                    label: "Open Project…";
                    shortcut: "⌘O";
                    activated => { root.load-project(); }
                }
                MenuRow {
                    label: "Save Project";
                    shortcut: "⌘S";
                    activated => { root.save-project(); }
                }
            }
            MenuButton {
                label: "Edit";
                y: (parent.height - self.height) / 2;
                MenuRow {
                    label: "Undo";
                    shortcut: "⌘Z";
                    activated => { root.undo(); }
                }
                MenuRow {
                    label: "Redo";
                    shortcut: "⇧⌘Z";
                    activated => { root.redo(); }
                }
            }
            MenuButton {
                label: "View";
                y: (parent.height - self.height) / 2;
                MenuRow {
                    label: "Zoom In";
                    shortcut: "+";
                    activated => { root.zoom-in(); }
                }
                MenuRow {
                    label: "Zoom Out";
                    shortcut: "−";
                    activated => { root.zoom-out(); }
                }
            }
        }

        // ── Right: Save + Export ──
        HorizontalLayout {
            spacing: Theme.spacing-sm;
            alignment: end;

            GhostButton {
                label: "Save";
                y: (parent.height - self.height) / 2;
                clicked => { root.save-project(); }
            }

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 26px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: color-ta.has-hover ? Palette.border-bright : Palette.border;
                background: color-ta.has-hover ? Palette.surface-2 : transparent;
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 7px;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-sm;
                        background: root.preview-color;
                        border-width: 1px;
                        border-color: Palette.border-bright;
                    }
                    Text {
                        text: "Color";
                        color: Palette.text;
                        font-size: Theme.font-sm;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                color-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { color-popup.show(); }
                }

                color-popup := PopupWindow {
                    x: parent.width - 278px;
                    y: parent.height + 7px;
                    ColorPickerPro {
                        selected-color: root.preview-color;
                        hex-code: root.preview-hex;
                        color-changed(c) => { root.preview-color = c; }
                        hex-edited(value) => { root.preview-hex = value; }
                    }
                }
            }

            // Primary Export action
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 26px;
                border-radius: Theme.radius-sm;
                opacity: (root.can-export && !root.exporting) ? 1.0 : 0.45;
                background: ex-ta.has-hover && root.can-export && !root.exporting
                    ? Palette.accent-2 : Palette.accent;
                animate background { duration: 120ms; }
                animate opacity { duration: 120ms; }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.exporting ? "Exporting…" : "Export";
                        color: white;
                        font-size: Theme.font-sm;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                ex-ta := TouchArea {
                    enabled: root.can-export && !root.exporting;
                    mouse-cursor: pointer;
                    clicked => { root.export-clicked(); }
                }
            }
        }
    }
}
