import { Palette } from "../styles/palette.slint";
import { Theme } from "../styles/theme.slint";

// Read-only metadata row (label left, value right).
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 28px;

    HorizontalLayout {
        alignment: space-between;
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.value == "" ? "—" : root.value;
            color: Palette.text;
            font-size: Theme.font-sm;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: Palette.border;
        opacity: 0.4;
    }
}

// A draggable numeric field: label on the left, value box on the right that
// you scrub horizontally to change (DaVinci / After Effects style).
component NumberField inherits Rectangle {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum: -1000000;
    in property <float> maximum: 1000000;
    in property <float> step: 1.0;          // value delta per pixel dragged
    in property <float> default-value: 0;
    in property <bool> percent: false;      // display value × 100
    in property <bool> integer: false;      // display/emit whole numbers
    in property <string> suffix: "";
    callback changed(float);
    // Fired when a scrub/reset gesture starts (used to checkpoint undo once).
    callback pressed();

    height: 30px;

    HorizontalLayout {
        spacing: Theme.spacing-sm;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: Theme.font-sm;
            width: 66px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: Theme.radius-sm;
            background: (fld.has-hover || fld.pressed) ? Palette.surface-2 : Palette.surface;
            border-width: 1px;
            border-color: fld.pressed ? Palette.accent : Palette.border;
            animate border-color { duration: 100ms; }
            animate background { duration: 100ms; }

            Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: root.percent
                    ? Math.round(root.value * 100) + (root.suffix == "" ? "%" : root.suffix)
                    : (root.integer
                        ? Math.round(root.value) + root.suffix
                        : (Math.round(root.value * 10) / 10) + root.suffix);
                color: Palette.text;
                font-size: Theme.font-sm;
                font-weight: 500;
                vertical-alignment: center;
            }

            // Scrub area covers the whole field (declared first so the reset
            // button below sits on top within its corner).
            fld := TouchArea {
                property <float> start-val;
                mouse-cursor: ew-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-val = root.value;
                        root.pressed();
                    }
                }
                moved => {
                    if (self.pressed) {
                        let delta = (self.mouse-x - self.pressed-x) / 1px;
                        let raw = self.start-val + delta * root.step;
                        let nv = max(root.minimum, min(root.maximum, raw));
                        root.value = nv;
                        root.changed(nv);
                    }
                }
            }

            // Reset affordance — appears on hover, snaps back to default.
            reset-ta := TouchArea {
                x: parent.width - self.width;
                width: 24px;
                visible: fld.has-hover || self.has-hover;
                mouse-cursor: pointer;
                clicked => {
                    root.pressed();
                    root.value = root.default-value;
                    root.changed(root.default-value);
                }
                Rectangle {
                    width: 16px; height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: reset-ta.has-hover ? Palette.surface-3 : transparent;
                    Text {
                        text: "⟲";
                        color: Palette.text-muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Compact pill switch for boolean settings.
component Switch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 30px;

    HorizontalLayout {
        spacing: Theme.spacing-sm;
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: Theme.font-sm;
            width: 66px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: 34px; height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.checked ? Palette.accent : Palette.surface-3;
            border-width: 1px;
            border-color: root.checked ? Palette.accent : Palette.border;
            animate background { duration: 120ms; }
            Rectangle {
                width: 12px; height: 12px;
                border-radius: 6px;
                background: white;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                y: (parent.height - self.height) / 2;
                animate x { duration: 120ms; easing: ease-out; }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
}

// One tab in the Picture/Audio/Info selector.
component TabItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: root.active ? Palette.text : (ta.has-hover ? Palette.text : Palette.text-muted);
        font-size: Theme.font-sm;
        font-weight: root.active ? 600 : 400;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    // Active underline
    Rectangle {
        x: 0; y: parent.height - 2px;
        width: 100%; height: 2px;
        background: root.active ? Palette.accent : transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DetailsPanel inherits Rectangle {
    in property <bool> has-selection;
    in property <string> selected-name;
    in property <string> selected-codec;
    in property <string> selected-resolution;
    in property <string> selected-duration;
    in property <string> selected-fps;

    in property <float> selected-volume: 1.0;
    in property <bool> selected-muted: false;
    in property <float> selected-opacity: 1.0;
    in property <float> selected-scale: 1.0;
    in property <int> selected-position-x: 0;
    in property <int> selected-position-y: 0;
    in property <float> selected-scale-x: 1.0;
    in property <float> selected-scale-y: 1.0;
    in property <float> selected-rotation: 0.0;
    in property <bool> selected-flip-h: false;
    in property <bool> selected-flip-v: false;

    callback volume-changed(float);
    callback muted-changed(bool);
    callback opacity-changed(float);
    callback scale-changed(float);
    callback position-x-changed(int);
    callback position-y-changed(int);
    callback scale-x-changed(float);
    callback scale-y-changed(float);
    callback rotation-changed(float);
    callback flip-h-changed(bool);
    callback flip-v-changed(bool);
    // Fired once at the start of a scrub/drag so the bridge can checkpoint undo.
    callback transform-gesture-begin();

    property <int> active-tab: 0;

    width: 264px;
    background: Palette.surface;

    // Left divider
    Rectangle {
        x: 0; y: 0;
        width: 1px; height: 100%;
        background: Palette.border;
    }

    VerticalLayout {
        padding: Theme.spacing-lg;
        spacing: Theme.spacing-md;
        alignment: start;

        // Title
        Text {
            text: "Properties";
            color: Palette.text;
            font-size: Theme.font-md;
            font-weight: 600;
        }

        if !root.has-selection : VerticalLayout {
            spacing: Theme.spacing-sm;
            padding-top: Theme.spacing-md;
            Text {
                text: "No clip selected";
                color: Palette.text-muted;
                font-size: Theme.font-sm;
            }
            Text {
                text: "Select a clip in the timeline to adjust its transform, audio, and details.";
                color: Palette.text-dim;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }

        if root.has-selection : VerticalLayout {
            spacing: Theme.spacing-md;

            // Clip name
            Text {
                text: root.selected-name;
                color: Palette.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }

            // Tabs
            Rectangle {
                height: 32px;
                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: 100%; height: 1px;
                    background: Palette.border;
                }
                HorizontalLayout {
                    TabItem {
                        label: "Picture";
                        active: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }
                    TabItem {
                        label: "Audio";
                        active: root.active-tab == 1;
                        clicked => { root.active-tab = 1; }
                    }
                    TabItem {
                        label: "Info";
                        active: root.active-tab == 2;
                        clicked => { root.active-tab = 2; }
                    }
                }
            }

            // ── Picture / Transform ──
            if root.active-tab == 0 : VerticalLayout {
                spacing: 4px;
                NumberField {
                    label: "Position X";
                    value: root.selected-position-x;
                    integer: true;
                    step: 1.0;
                    suffix: "";
                    default-value: 0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.position-x-changed(Math.round(v)); }
                }
                NumberField {
                    label: "Position Y";
                    value: root.selected-position-y;
                    integer: true;
                    step: 1.0;
                    default-value: 0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.position-y-changed(Math.round(v)); }
                }
                NumberField {
                    label: "Scale";
                    value: root.selected-scale;
                    percent: true;
                    minimum: 0.0;
                    maximum: 2.0;
                    step: 0.005;
                    default-value: 1.0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.scale-changed(v); }
                }
                NumberField {
                    label: "Scale X";
                    value: root.selected-scale-x;
                    percent: true;
                    minimum: 0.0;
                    maximum: 4.0;
                    step: 0.005;
                    default-value: 1.0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.scale-x-changed(v); }
                }
                NumberField {
                    label: "Scale Y";
                    value: root.selected-scale-y;
                    percent: true;
                    minimum: 0.0;
                    maximum: 4.0;
                    step: 0.005;
                    default-value: 1.0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.scale-y-changed(v); }
                }
                NumberField {
                    label: "Rotation";
                    value: root.selected-rotation;
                    integer: true;
                    minimum: -360;
                    maximum: 360;
                    step: 0.5;
                    suffix: "°";
                    default-value: 0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.rotation-changed(v); }
                }
                NumberField {
                    label: "Opacity";
                    value: root.selected-opacity;
                    percent: true;
                    minimum: 0.0;
                    maximum: 1.0;
                    step: 0.004;
                    default-value: 1.0;
                    pressed => { root.transform-gesture-begin(); }
                    changed(v) => { root.opacity-changed(v); }
                }
                Switch {
                    label: "Flip H";
                    checked: root.selected-flip-h;
                    toggled(m) => { root.transform-gesture-begin(); root.flip-h-changed(m); }
                }
                Switch {
                    label: "Flip V";
                    checked: root.selected-flip-v;
                    toggled(m) => { root.transform-gesture-begin(); root.flip-v-changed(m); }
                }
            }

            // ── Audio ──
            if root.active-tab == 1 : VerticalLayout {
                spacing: 4px;
                NumberField {
                    label: "Volume";
                    value: root.selected-volume;
                    percent: true;
                    minimum: 0.0;
                    maximum: 2.0;
                    step: 0.005;
                    default-value: 1.0;
                    changed(v) => { root.volume-changed(v); }
                }
                Switch {
                    label: "Mute";
                    checked: root.selected-muted;
                    toggled(m) => { root.muted-changed(m); }
                }
            }

            // ── Info ──
            if root.active-tab == 2 : VerticalLayout {
                spacing: 0px;
                InfoRow { label: "Codec";      value: root.selected-codec; }
                InfoRow { label: "Resolution"; value: root.selected-resolution; }
                InfoRow { label: "Duration";   value: root.selected-duration; }
                InfoRow { label: "Frame rate"; value: root.selected-fps; }
            }
        }
    }
}
