export global Theme {
    // Spacing scale (Compact, High-Density Layout)
    out property <length> spacing-xs: 3px;
    out property <length> spacing-sm: 6px;
    out property <length> spacing-md: 10px;
    out property <length> spacing-lg: 12px;
    out property <length> spacing-xl: 18px;

    // Radii (Sharp, Professional Corners)
    out property <length> radius-sm: 3px;
    out property <length> radius:    4px;
    out property <length> radius-lg: 6px;

    // Typography
    out property <length> font-xs: 10px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 20px;
}
