export global Palette {
    // Surfaces — flat, neutral charcoal (clean & minimal)
    out property <color> background:     #0d0e10;
    out property <color> surface:        #151619;
    out property <color> surface-2:      #1c1d21;
    out property <color> surface-3:      #262830;
    out property <color> overlay:        #0d0e10aa;

    // Borders / dividers — hairline, low-contrast
    out property <color> border:         #26272d;
    out property <color> border-bright:  #383a42;

    // Text
    out property <color> text:           #e6e7ea;
    out property <color> text-muted:     #9a9ca4;
    out property <color> text-dim:       #62646c;

    // Accent — clean royal blue (used sparingly, < 5% of UI)
    out property <color> accent:         #2f6fed;
    out property <color> accent-2:       #5188f5;
    out property <color> accent-soft:    #2f6fed1f;
    out property <color> accent-glow:    #2f6fed25;

    // Semantic
    out property <color> success:        #2ea87a;
    out property <color> warning:        #e0931f;
    out property <color> danger:         #d8474c;
    out property <color> danger-soft:    #d8474c22;
}
