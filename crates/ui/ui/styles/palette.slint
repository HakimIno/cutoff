export global Palette {
    // Surfaces (Pro Studio Charcoal)
    out property <color> background:     #101113;
    out property <color> surface:        #17181c;
    out property <color> surface-2:      #202126;
    out property <color> surface-3:      #2a2c33;
    out property <color> overlay:        #101113aa;

    // Borders / dividers (Subtle Slate/Charcoal)
    out property <color> border:         #272930;
    out property <color> border-bright:  #383b45;

    // Text
    out property <color> text:           #e2e4e9;
    out property <color> text-muted:     #9ea1a9;
    out property <color> text-dim:       #646770;

    // Accents (DaVinci Resolve Style Slate-Blue)
    out property <color> accent:         #007acc;
    out property <color> accent-2:       #0098ff;
    out property <color> accent-glow:    #007acc25;

    // Semantic
    out property <color> success:        #2ea87a;
    out property <color> warning:        #e0931f;
    out property <color> danger:         #d03e43;
    out property <color> danger-soft:    #d03e4322;
}
