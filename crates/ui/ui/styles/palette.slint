export global Palette {
    // Surfaces (Pro Studio Charcoal)
    out property <color> background:     #121212;
    out property <color> surface:        #1e1e1e;
    out property <color> surface-2:      #262626;
    out property <color> surface-3:      #303030;
    out property <color> overlay:        #121212aa;

    // Borders / dividers (Subtle Slate/Charcoal)
    out property <color> border:         #2e2e2e;
    out property <color> border-bright:  #404040;

    // Text
    out property <color> text:           #f5f5f7;
    out property <color> text-muted:     #8e8e93;
    out property <color> text-dim:       #5c5c5e;

    // Accents (Premium Royal Blue)
    out property <color> accent:         #0066cc;
    out property <color> accent-2:       #0055ff;
    out property <color> accent-glow:    #0066cc33;

    // Semantic
    out property <color> success:        #2ea87a;
    out property <color> warning:        #e0931f;
    out property <color> danger:         #d03e43;
    out property <color> danger-soft:    #d03e4322;
}
